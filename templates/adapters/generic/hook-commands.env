AI_DEV_KIT_PATH="{{AI_DEV_KIT_PATH}}"
PROJECT_PATH="{{PROJECT_PATH}}"
AI_DEV_KIT_STOP_GATE='bash "{{AI_DEV_KIT_PATH}}/scripts/skill-first-gate.sh" --phase stop --project "{{PROJECT_PATH}}"'
AI_DEV_KIT_PREFLIGHT_GATE='bash "{{AI_DEV_KIT_PATH}}/scripts/skill-first-gate.sh" --phase preflight --project "{{PROJECT_PATH}}"'
AI_DEV_KIT_MERGE_GATE='bash "{{AI_DEV_KIT_PATH}}/scripts/skill-first-gate.sh" --phase merge --project "{{PROJECT_PATH}}"'

