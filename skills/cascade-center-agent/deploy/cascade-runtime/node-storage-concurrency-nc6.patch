+# A write that loses its compare-and-swap is redone on fresh state. Waits
+# between attempts are drawn uniformly below a ceiling that doubles from 50 ms
+# to 400 ms; redoing stops at the deadline, and the write then fails with
+# STATE_CONFLICT having published nothing. The ceiling also shrinks with the
+# time the write has already waited (halving about every second, down to
+# 10 ms), so under a burst the writers that have waited longest fetch first
+# after each published commit and win more often than newcomers, which still
+# back off up to 400 ms. WRITE_ATTEMPTS only guards against a storage that
+# fails instantly; fast attempts at the 10 ms floor reach the deadline first.
+WRITE_ATTEMPTS = 100_000
+WRITE_DEADLINE_SECONDS = 60.0
+_WRITE_BACKOFF_INITIAL = 0.05
+_WRITE_BACKOFF_MAX = 0.4
+_WRITE_BACKOFF_FLOOR = 0.01
+_WRITE_AGING_SECONDS = 1.5
+
+
+def _redo_ceiling(attempt: int, waited: float) -> float:
+    """Upper bound of the wait before redo ``attempt`` (1-based) after ``waited`` seconds."""
+    grown = _WRITE_BACKOFF_INITIAL * 2.0 ** min(attempt - 1, 16)
+    aged = _WRITE_BACKOFF_MAX * math.exp(-waited / _WRITE_AGING_SECONDS)
+    return max(_WRITE_BACKOFF_FLOOR, min(_WRITE_BACKOFF_MAX, grown, aged))
