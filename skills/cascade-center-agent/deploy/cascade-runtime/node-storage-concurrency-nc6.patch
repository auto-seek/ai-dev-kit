+"""File-backed claim heartbeats in ``<base>/heartbeats/<key>.json``.
+
+Callers hold the storage lock, so a renewal can never race another writer
+here and ``renew`` needs no compare-and-swap.
+"""
+
+from __future__ import annotations
+
+import json
+import os
+from collections.abc import Mapping, Sequence
+from pathlib import Path
+
+from cascade import __version__
+from cascade.types import Heartbeat, heartbeat_key, validate_node_id
