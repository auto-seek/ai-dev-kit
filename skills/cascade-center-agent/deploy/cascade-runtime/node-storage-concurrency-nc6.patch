+    candidates = {"default", "bench", "a.lock", "a.lockb", "lock", "-a", "a-", "_", "a.b"}
+    candidates.update(x + y + z for x in alphabet for y in alphabet for z in alphabet)
+    candidates.update(f"x{c}.lock" for c in alphabet)
+
+    def git_accepts(namespace: str) -> bool:
+        refs = (
+            f"refs/heads/cascade-state/{namespace}",
+            f"refs/heads/cascade-archive/{namespace}/0123456789ab",
+            f"refs/heads/cascade-heartbeat/{namespace}/{'0' * 64}",
+            f"refs/cascade-cache/heartbeat/{namespace}/{'0' * 64}",
+        )
+        return all(
+            subprocess.run(["git", "check-ref-format", ref], capture_output=True).returncode == 0
+            for ref in refs
+        )
+
+    expected = {namespace: git_accepts(namespace) for namespace in sorted(candidates)}
+
+    def no_git(*args: Any, **kwargs: Any) -> Any:
+        raise AssertionError("namespace validation started a process")
+
+    monkeypatch.setattr(subprocess, "run", no_git)
+    for namespace, accepted in expected.items():
+        try:
+            git_ref_lease._validate_namespace(namespace)
+        except ValueError:
+            assert not accepted, namespace
+        else:
+            assert accepted, namespace
+
