+def _record_backoff(
+    monkeypatch: pytest.MonkeyPatch,
+) -> tuple[list[tuple[float, float]], list[float]]:
+    """Record jitter bounds and actual sleeps; jitter picks the upper bound."""
+    bounds: list[tuple[float, float]] = []
+    sleeps: list[float] = []
+    real_sleep = time.sleep
+
+    def uniform(low: float, high: float) -> float:
+        bounds.append((low, high))
+        return high
+
+    def sleep(seconds: float) -> None:
+        sleeps.append(seconds)
+        real_sleep(seconds)
+
+    monkeypatch.setattr(git_ref_lease.random, "uniform", uniform)
+    monkeypatch.setattr(git_ref_lease.time, "sleep", sleep)
