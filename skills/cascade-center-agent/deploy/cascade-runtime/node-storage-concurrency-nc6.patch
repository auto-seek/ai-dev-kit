+class TestWriteConflicts:
+    def test_redo_waits_grow_for_newcomers_and_shrink_with_time_waited(self):
+        """Long-waiting writers redo sooner than writers that just started."""
+        from cascade.client.base import _redo_ceiling
+
+        assert [_redo_ceiling(n, 0.0) for n in (1, 2, 3, 4, 5)] == [0.05, 0.1, 0.2, 0.4, 0.4]
+        aged = [_redo_ceiling(20, waited) for waited in (0.0, 1.0, 2.0, 3.0, 5.0, 30.0)]
+        assert aged == sorted(aged, reverse=True)
+        assert aged[0] == 0.4 and aged[-1] == 0.01
+        # A writer that has waited 3 s redoes within ~54 ms; a newcomer on
+        # its fourth attempt may wait up to 400 ms.
+        assert _redo_ceiling(20, 3.0) < _redo_ceiling(4, 0.3) / 5
+
+    def test_fast_lost_attempts_redo_until_the_deadline(self, monkeypatch: pytest.MonkeyPatch):
+        """Attempts of 5 ms at the 10 ms wait floor run out of time, not of attempts."""
+        from collections.abc import Generator
+        from contextlib import contextmanager
+
+        from cascade.client import base
+        from cascade.core.cascade import Cascade
+        from cascade.errors import StateConflictError
+
+        clock = [0.0]
+        attempts = [0]
+
+        class Heartbeats:
+            def current(self) -> dict:
+                return {}
+
+            def stage(self, started, active) -> None:
+                pass
+
+        class AlwaysLosesFast:
+            heartbeats = Heartbeats()
+
+            @contextmanager
+            def lock(self, timeout: float = 10.0, blocking: bool = True) -> Generator[None]:
+                attempts[0] += 1
+                clock[0] += 0.005
+                yield
+                raise StateConflictError("another writer published first")
+
+            def load(self) -> Cascade:
+                return Cascade()
+
+        def sleep(seconds: float) -> None:
+            clock[0] += seconds
+
+        monkeypatch.setattr(base.time, "monotonic", lambda: clock[0])
+        monkeypatch.setattr(base.time, "sleep", sleep)
+        monkeypatch.setattr(base.random, "uniform", lambda low, high: high)
+
+        client = CascadeClient(AlwaysLosesFast())  # type: ignore[arg-type]
+        result = client._transact(lambda tx: Result(success=True, message="ok"))
+
+        assert result.code == "STATE_CONFLICT"
+        assert attempts[0] > 1000
+        assert base.WRITE_DEADLINE_SECONDS - 0.02 <= clock[0] <= base.WRITE_DEADLINE_SECONDS
+
+    def test_redo_sleeps_follow_the_ceiling_until_the_deadline(
+        self, tmp_path, monkeypatch: pytest.MonkeyPatch
+    ):
+        from collections.abc import Generator
+        from contextlib import contextmanager
+
+        from cascade.client import base
+        from cascade.errors import StateConflictError
+        from cascade.storage.file_storage import FileStorage
+
+        clock = [1000.0]
+        sleeps: list[float] = []
+
+        def sleep(seconds: float) -> None:
+            sleeps.append(seconds)
+            clock[0] += seconds
+
+        class AlwaysLoses(FileStorage):
+            @contextmanager
+            def lock(self, timeout: float = 10.0, blocking: bool = True) -> Generator[None]:
+                with super().lock(timeout=timeout, blocking=blocking):
+                    clock[0] += 0.2  # one fetch-to-push window
+                    yield
+                    raise StateConflictError("another writer published first")
+
+        monkeypatch.setattr(base.time, "monotonic", lambda: clock[0])
+        monkeypatch.setattr(base.time, "sleep", sleep)
+        monkeypatch.setattr(base.random, "uniform", lambda low, high: high)
+        monkeypatch.setattr(base, "WRITE_DEADLINE_SECONDS", 10.0)
+
+        result = CascadeClient(AlwaysLoses(tmp_path / "state")).add("a")
+
+        assert result.code == "STATE_CONFLICT"
+        assert sleeps[:3] == [0.05, 0.1, 0.2]
+        peak = sleeps.index(max(sleeps))
+        assert sleeps[peak:] == sorted(sleeps[peak:], reverse=True)
+        assert sleeps[-1] == 0.01 and min(sleeps) == 0.01
+        assert clock[0] <= 1000.0 + 10.0 + 0.2
+
+    def test_a_write_that_keeps_losing_reports_state_conflict(
+        self, tmp_path, monkeypatch: pytest.MonkeyPatch
