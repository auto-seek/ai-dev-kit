+def _stat(path: Path) -> tuple[int, int]:
+    info = path.stat()
+    return info.st_ino, info.st_mtime_ns
+
+
+def _git_subcommands(log: Path) -> list[str]:
+    """Every logged git subcommand, local or remote, in order."""
+    found = []
+    if not log.exists():
+        return found
+    for line in log.read_text(encoding="utf-8").splitlines():
+        args = [arg for arg in line.split("\x1f") if arg]
+        index = 0
+        while index < len(args) and args[index] in ("-C", "--git-dir", "-c"):
+            index += 2
+        if index < len(args):
+            found.append(args[index])
+    return found
+
