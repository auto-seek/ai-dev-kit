+def parse_heartbeat(text: str, *, namespace: str, key: str) -> tuple[Heartbeat | None, str]:
+    """A stored heartbeat, or None with the reason it cannot be used.
+
+    ``key`` is where the heartbeat was stored (its ref or file key), which
+    must be ``heartbeat_key`` of the payload's task.
+    """
+    try:
+        data = json.loads(text)
+    except ValueError as exc:
+        return None, f"payload is not JSON: {exc}"
+    try:
+        heartbeat = Heartbeat.from_payload(data)
+    except ValueError as exc:
+        return None, f"payload is invalid: {exc}"
+    if heartbeat.namespace != namespace:
+        return None, f"namespace {heartbeat.namespace!r} is not {namespace!r}"
+    if heartbeat_key(heartbeat.task_id) != key:
+        return None, f"task {heartbeat.task_id!r} does not belong under key {key}"
+    return heartbeat, ""
+
+
+def stale_heartbeats(
+    current: Mapping[str, Heartbeat], active: Mapping[str, tuple[str, int]]
+) -> list[str]:
+    """Task IDs whose heartbeat no longer belongs to an ACTIVE claim."""
+    return [
+        task_id
+        for task_id, heartbeat in current.items()
+        if active.get(task_id) != (heartbeat.agent_id, heartbeat.claim_token)
+    ]
+
+
+def make_heartbeat(
+    namespace: str,
+    task_id: str,
+    agent_id: str,
+    claim_token: int,
+    renewed_at: float,
+    timeout: float | None,
+) -> Heartbeat:
+    return Heartbeat(
+        namespace=namespace,
+        task_id=task_id,
+        agent_id=agent_id,
+        claim_token=claim_token,
+        renewed_at=renewed_at,
+        timeout=timeout,
+        runtime=__version__,
+    )
+
+
+class FileHeartbeatStore:
+    def __init__(self, base_dir: Path | str, namespace: str = "default") -> None:
+        self._dir = Path(base_dir) / "heartbeats"
+        self._namespace = namespace
+
+    def make(
+        self,
+        task_id: str,
+        agent_id: str,
+        claim_token: int,
+        renewed_at: float,
+        timeout: float | None,
+    ) -> Heartbeat:
+        return make_heartbeat(self._namespace, task_id, agent_id, claim_token, renewed_at, timeout)
+
+    def _path(self, task_id: str) -> Path:
+        validate_node_id(task_id)
+        return self._dir / f"{heartbeat_key(task_id)}.json"
+
