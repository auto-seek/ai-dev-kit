+++ b/tests/acceptance/git_storage_agent_load.py
@@ -0,0 +1,179 @@
+#!/usr/bin/env python3
+# Copyright 2026 Hangzhou Autoseek Information Technology Co., Ltd.
+#
+# Licensed under the Apache License, Version 2.0 (the "License");
+# you may not use this file except in compliance with the License.
+# You may obtain a copy of the License at
+#
+#     http://www.apache.org/licenses/LICENSE-2.0
+#
+# Unless required by applicable law or agreed to in writing, software
+# distributed under the License is distributed on an "AS IS" BASIS,
+# WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+# See the License for the specific language governing permissions and
+# limitations under the License.
+
+"""Latency of claim, renew and complete with many agents on one Git namespace.
+
+Perspective: a center with twenty agents working through a shared pool.
+Invariant: every claim, renewal and completion succeeds (no conflict
+failures), each task completes exactly once, and the event chain stays valid.
+Goal: report p50/p95/max per operation; ``--remote-delay`` adds a fixed sleep
+to every ls-remote/fetch/push to approximate an SSH round trip.
+Migration: an explicit acceptance run; the default suite covers correctness
+with smaller loads.
+"""
+
+from __future__ import annotations
+
+import argparse
+import json
+import os
+import random
+import shutil
+import statistics
+import sys
+import tempfile
+from pathlib import Path
+from typing import Any
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
+
+from git_remote_kit import SRC, finish_agent, make_remote, start_agent  # noqa: E402
+
+from cascade.client import CascadeClient  # noqa: E402
+from cascade.replay import verify  # noqa: E402
+from cascade.storage.git_storage import GitStorage  # noqa: E402
+
+NAMESPACE = "load"
+
+
+def _delaying_git(bin_dir: Path, delay: float) -> Path:
+    real_git = shutil.which("git")
+    assert real_git is not None
+    bin_dir.mkdir(parents=True, exist_ok=True)
+    wrapper = bin_dir / "git"
+    wrapper.write_text(
+        "#!/bin/bash\n"
+        'for arg in "$@"; do case "$arg" in ls-remote|fetch|push) '
+        f"sleep {delay}; break;; esac; done\n"
+        f'exec "{real_git}" "$@"\n',
+        encoding="utf-8",
+    )
+    wrapper.chmod(0o755)
+    return bin_dir
+
+
+def _percentiles(values: list[float]) -> dict[str, float]:
+    ordered = sorted(values)
+    p95 = ordered[min(len(ordered) - 1, round(0.95 * (len(ordered) - 1)))]
+    return {
+        "count": len(ordered),
+        "p50": round(statistics.median(ordered), 3),
+        "p95": round(p95, 3),
+        "max": round(ordered[-1], 3),
+    }
+
+
+def run(
+    agents: int,
+    rounds: int,
+    renewals: int,
+    interval: float,
+    delay: float,
+    stagger: float = 0.0,
+    runtime: Path = SRC,
+) -> dict[str, Any]:
+    with tempfile.TemporaryDirectory(prefix="cascade-agent-load-") as raw:
+        root = Path(raw)
+        remote = make_remote(root / "remote.git")
+        publisher = CascadeClient(
+            GitStorage(str(remote), namespace=NAMESPACE, cache_dir=root / "pub")
+        )
+        for index in range(agents * rounds):
+            assert publisher.add(f"task-{index:04d}").success
+        path_prefix = _delaying_git(root / "bin", delay) if delay > 0 else None
+        processes = []
+        for index in range(agents):
+            agent = f"agent-{index:02d}"
+            ops: list[dict[str, Any]] = [{"op": "sleep", "seconds": random.uniform(0, stagger)}]
+            for _ in range(rounds):
+                ops.append({"op": "claim", "agent": agent, "timeout": 120})
+                ops.append({"op": "renew", "agent": agent, "times": renewals, "interval": interval})
+                ops.append({"op": "complete", "agent": agent})
+            spec = {
+                "remote": str(remote),
+                "namespace": NAMESPACE,
+                "cache": str(root / agent),
+                "ops": ops,
+            }
+            processes.append(start_agent(runtime, spec, path_prefix=path_prefix))
+        results = [finish_agent(process, timeout=900) for process in processes]
+        items = [item for result in results for item in result["results"]]
+        failures = [item for item in items if not item["success"]]
+        report: dict[str, Any] = {
+            "runtime": results[0]["version"],
+            "stagger_seconds": stagger,
+            "agents": agents,
+            "rounds": rounds,
+            "renewals_per_task": renewals,
+            "remote_delay_seconds": delay,
+            "failures": len(failures),
+            "failure_codes": sorted({str(item.get("code")) for item in failures}),
+        }
+        for kind in ("claim", "renew", "complete"):
+            report[kind] = _percentiles(
+                [item["seconds"] for item in items if item["op"] == kind and item["success"]]
+                or [0.0]
+            )
+        for kind in ("claim", "complete"):
+            attempts = [item.get("transactions", 1) for item in items if item["op"] == kind]
+            report[f"{kind}_transactions"] = _percentiles([float(value) for value in attempts])
+        storage = GitStorage(str(remote), namespace=NAMESPACE, cache_dir=root / "audit")
+        with storage.read_snapshot():
+            graph = storage.load()
+            assert graph is not None
+            events = storage.events.read_all()
+            report["chain_valid"] = storage.events.verify_chain()[0]
+            report["replay_matches"] = verify(events, graph, storage.content) == []
+        report["failures_by_op"] = {
+            kind: sum(1 for item in failures if item["op"] == kind)
+            for kind in ("claim", "renew", "complete")
+        }
+        report["completed"] = sum(node.state.name == "COMPLETED" for node in graph.nodes.values())
+        report["completions_logged"] = sum(event.type.value == "task_completed" for event in events)
+        return report
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--agents", type=int, default=20)
+    parser.add_argument("--rounds", type=int, default=2)
+    parser.add_argument("--renewals", type=int, default=3)
+    parser.add_argument("--interval", type=float, default=0.5)
+    parser.add_argument("--remote-delay", type=float, default=0.0)
+    parser.add_argument("--stagger", type=float, default=0.0, help="random start delay bound")
+    parser.add_argument("--runtime", type=Path, default=SRC, help="PYTHONPATH of the agents")
+    args = parser.parse_args()
+    os.environ.pop("CASCADE_GIT_LOG", None)
+    report = run(
+        args.agents,
+        args.rounds,
+        args.renewals,
+        args.interval,
+        args.remote_delay,
+        args.stagger,
+        args.runtime,
+    )
+    print(json.dumps(report, indent=2, sort_keys=True))
+    healthy = (
+        report["failures"] == 0
+        and report["chain_valid"]
+        and report["replay_matches"]
+        and report["completed"] == report["completions_logged"] == args.agents * args.rounds
+    )
+    return 0 if healthy else 1
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
