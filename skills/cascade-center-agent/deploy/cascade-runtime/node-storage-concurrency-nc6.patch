+"""Read snapshots and optimistic atomic publication against real bare Git remotes.
+
+Perspective: a busy center whose verifiers read constantly while agents write.
+Invariant: read snapshots never change remote refs and always come from one
+state commit; a write publishes with one atomic expected-OID push, a lost
+compare-and-swap publishes nothing and is redone on the latest state, and
+every failure leaves either the old state or the complete new state.
+Goal: cut remote round trips and remove the global write lock without losing
+updates, serving a stale cache, or reporting a half-published transaction.
+Migration: integration evidence since 0.8.2+nodecollab.2 (reads) and .3
+(lock-free writes); heartbeats, mixed runtimes and remote-call comparisons
+live in their own Git storage test modules.
+"""
+
+from __future__ import annotations
+
+import json
+import os
+import subprocess
+import time
+from pathlib import Path
+from typing import Any
+
+import pytest
+from git_remote_kit import (
+    SRC,
+    commit_count,
+    finish_agent,
+    git_blob,
+    install_git_counter,
+    make_remote,
+    remote_calls,
+    remote_refs,
+    run_agent,
+    start_agent,
+)
+
+from cascade.client import CascadeClient
+from cascade.core.cascade import Cascade
+from cascade.core.node import Node
+from cascade.core.state import NodeState
+from cascade.errors import LockError, StateConflictError, StorageCorruptionError
+from cascade.events import Event
+from cascade.replay import verify
+from cascade.storage.git_storage import GitStorage
+from cascade.types import TaskView
+from cascade.verification import verify_log, verify_storage
+
+NAMESPACE = "snap"
+STATE_REF = f"refs/heads/cascade-state/{NAMESPACE}"
+LOCK_REF = f"refs/heads/cascade-lock/{NAMESPACE}"
+
+
+def _storage(remote: Path, cache: Path, **options: Any) -> GitStorage:
+    return GitStorage(str(remote), namespace=NAMESPACE, cache_dir=cache, **options)
+
+
+def _client(remote: Path, cache: Path) -> CascadeClient:
+    return CascadeClient(_storage(remote, cache))
+
+
+def _spec(remote: Path, cache: Path, ops: list[dict[str, Any]]) -> dict[str, Any]:
+    return {"remote": str(remote), "namespace": NAMESPACE, "cache": str(cache), "ops": ops}
+
+
+def _ids(client: CascadeClient) -> list[str]:
+    listed = client.nodes()
+    assert listed.success, listed.message
+    return sorted(node["id"] for node in listed.data["nodes"])
+
+
+def _rogue_commit(remote: Path, parent: str, message: str) -> str:
+    """A complete commit made directly in the remote, bypassing every lease."""
+    return subprocess.run(
+        ["git", "--git-dir", str(remote), "commit-tree", f"{parent}^{{tree}}", "-p", parent],
+        input=message,
+        check=True,
+        capture_output=True,
+        text=True,
+    ).stdout.strip()
+
+
+def _set_ref(remote: Path, ref: str, oid: str) -> None:
+    subprocess.run(["git", "--git-dir", str(remote), "update-ref", ref, oid], check=True)
+
+
+def _install_hook(remote: Path, name: str, body: str) -> None:
+    hook = remote / "hooks" / name
+    hook.write_text("#!/bin/sh\n" + body, encoding="utf-8")
+    hook.chmod(0o755)
+
+
+@pytest.fixture
+def remote(tmp_path: Path) -> Path:
+    return make_remote(tmp_path / "remote.git")
+
+
+@pytest.fixture
+def seeded(remote: Path, tmp_path: Path) -> CascadeClient:
+    """A namespace with nodes, an active claim, and history to read."""
+    writer = _client(remote, tmp_path / "seed-cache")
+    assert writer.add("alpha").success
+    assert writer.add("beta").success
+    assert writer.claim("worker", "beta").success
+    return writer
+
