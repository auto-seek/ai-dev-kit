+class TestReadSnapshot:
+    def test_read_snapshot_waits_for_a_writer_transaction(self, storage: FileStorage):
+        """Graph and events are separate files, so readers wait for the writer's lock."""
+        writer_inside = threading.Event()
+        release_writer = threading.Event()
+        seen: list[set[str]] = []
+
+        def writer() -> None:
+            with storage.lock():
+                graph = Cascade()
+                graph.add_node(Node(id="first", state=NodeState.READY))
+                storage.save(graph)
+                writer_inside.set()
+                release_writer.wait(timeout=5)
+                graph.add_node(Node(id="second", state=NodeState.READY))
+                storage.save(graph)
+
+        thread = threading.Thread(target=writer)
+        thread.start()
+        assert writer_inside.wait(timeout=5)
+
+        def reader() -> None:
+            with storage.read_snapshot(timeout=5):
+                loaded = storage.load()
+                seen.append(set(loaded.nodes) if loaded else set())
+
+        reading = threading.Thread(target=reader)
+        reading.start()
+        time.sleep(0.05)
+        assert seen == []
+        release_writer.set()
+        thread.join(timeout=5)
+        reading.join(timeout=5)
+        assert seen == [{"first", "second"}]
+
