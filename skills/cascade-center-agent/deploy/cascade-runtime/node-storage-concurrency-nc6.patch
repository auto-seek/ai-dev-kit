index db0493c3b3874fa041f2e2ba9dd74f3f5c145497..b101bab34f34ee552f19361e6b245156496e8be7 100644
--- a/tests/acceptance/git_storage_hosted.py
+++ b/tests/acceptance/git_storage_hosted.py
@@ -36,7 +36,7 @@ from pathlib import Path
