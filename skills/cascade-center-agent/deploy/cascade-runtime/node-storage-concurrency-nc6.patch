+def test_lost_cas_redoes_the_write_on_the_latest_state(
+    remote: Path, seeded: CascadeClient, tmp_path: Path, monkeypatch: pytest.MonkeyPatch
+) -> None:
+    storage = _storage(remote, tmp_path / "writer")
+    client = CascadeClient(storage)
+    intruder = _client(remote, tmp_path / "intruder")
+    assert _ids(client) == ["alpha", "beta"]
+    real_commit = storage._commit_state
+    attempts: list[str | None] = []
+    log = tmp_path / "git.log"
+    monkeypatch.setenv("PATH", f"{install_git_counter(tmp_path / 'bin')}:{os.environ['PATH']}")
+
+    def race_then_commit() -> str | None:
+        attempts.append(storage.state_oid)
+        if len(attempts) == 1:
+            # Another writer publishes after this attempt read the state.
+            os.environ.pop("CASCADE_GIT_LOG")
+            assert intruder.add("intruder").success
+            os.environ["CASCADE_GIT_LOG"] = str(log)
+        return real_commit()
+
+    monkeypatch.setattr(storage, "_commit_state", race_then_commit)
+    monkeypatch.setenv("CASCADE_GIT_LOG", str(log))
+
+    assert client.add("mine", op_id="add-mine").success
+    monkeypatch.delenv("CASCADE_GIT_LOG")
+    assert len(attempts) == 2 and attempts[0] != attempts[1]
+    # The redo moves the worktree from the lost commit to the winner's with
+    # one two-tree read-tree; nothing is checked out in full.
+    calls = _git_subcommands(log)
+    assert calls.count("read-tree") == 1 and "checkout-index" not in calls
+    assert calls.count("fetch") == 2 and calls.count("push") == 2
+    assert _ids(_client(remote, tmp_path / "observer")) == ["alpha", "beta", "intruder", "mine"]
+    history = _client(remote, tmp_path / "auditor").history(node_id="mine").data["events"]
+    assert [event["type"] for event in history] == ["node_added"]
+    repeated = client.add("mine", op_id="add-mine")
+    assert repeated.success and len(attempts) == 3
