index 0000000000000000000000000000000000000000..dcf71ea5e00ad8669a836bcbe27d3e6c159e87cb
--- /dev/null
+++ b/tests/acceptance/git_storage_back_to_back.py
@@ -0,0 +1,161 @@
+#!/usr/bin/env python3
+# Copyright 2026 Hangzhou Autoseek Information Technology Co., Ltd.
+#
+# Licensed under the Apache License, Version 2.0 (the "License");
+# you may not use this file except in compliance with the License.
+# You may obtain a copy of the License at
+#
+#     http://www.apache.org/licenses/LICENSE-2.0
+#
+# Unless required by applicable law or agreed to in writing, software
+# distributed under the License is distributed on an "AS IS" BASIS,
+# WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+# See the License for the specific language governing permissions and
+# limitations under the License.
+
+"""Writes that follow the writer's own publish, against writes at random times.
+
+Perspective: an agent that completes a task and claims the next one at once.
+Invariant: every write lands once; the event chain stays valid.
+Goal: report compare-and-swap attempts per write for the first write of each
+pair (started at a random time) and the second (started right after the
+writer's own publish). Writers that lost to that publish redo at once, so
+without yielding the second write tends to lose to one of them.
+``--gap`` waits between the two writes of a pair, like a command-line agent
+that starts a new process for the second write (0.3 to 0.8 s at a center);
+``--hook-seconds`` adds a pre-receive hook that sleeps, like a center guard;
+``--remote-delay`` sleeps before every fetch/push like a network round trip;
+``--no-yield`` turns the runtime's yield after its own publish off.
+Migration: an explicit acceptance run; tests cover the yield deterministically.
+"""
+
+from __future__ import annotations
+
+import argparse
+import json
+import os
+import random
+import statistics
+import sys
+import tempfile
+from pathlib import Path
+from typing import Any
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
+
+from git_remote_kit import SRC, finish_agent, make_remote, start_agent  # noqa: E402
+from git_storage_agent_load import _delaying_git  # noqa: E402
+
+from cascade.replay import verify  # noqa: E402
+from cascade.storage.git_storage import GitStorage  # noqa: E402
+
+NAMESPACE = "pairs"
+
+
+def run(
+    agents: int,
+    pairs: int,
+    think: float,
+    gap: float,
+    delay: float,
+    hook_seconds: float,
+    runtime: Path,
+    no_yield: bool,
+    seed: int,
+) -> dict[str, Any]:
+    rng = random.Random(seed)
+    with tempfile.TemporaryDirectory(prefix="cascade-back-to-back-") as raw:
+        root = Path(raw)
+        remote = make_remote(root / "remote.git")
+        if hook_seconds > 0:
+            hook = remote / "hooks" / "pre-receive"
+            hook.write_text(f"#!/bin/sh\ncat >/dev/null\nsleep {hook_seconds}\n", encoding="utf-8")
+            hook.chmod(0o755)
+        path_prefix = _delaying_git(root / "bin", delay) if delay > 0 else None
+        processes = []
+        for index in range(agents):
+            ops: list[dict[str, Any]] = []
+            for pair in range(pairs):
+                ops.append({"op": "sleep", "seconds": rng.uniform(0, think)})
+                ops.append({"op": "add", "id": f"a{index:02d}-{pair:03d}"})
+                if gap > 0:
+                    ops.append({"op": "sleep", "seconds": gap})
+                ops.append({"op": "add", "id": f"b{index:02d}-{pair:03d}"})
+            spec = {
+                "remote": str(remote),
+                "namespace": NAMESPACE,
+                "cache": str(root / f"agent-{index:02d}"),
+                "ops": ops,
+                "no_yield": no_yield,
+            }
+            processes.append(start_agent(runtime, spec, path_prefix=path_prefix))
+        results = [finish_agent(process, timeout=1800) for process in processes]
+        items = [item for result in results for item in result["results"]]
+        report: dict[str, Any] = {
+            "runtime": results[0]["version"],
+            "yield": not no_yield,
+            "agents": agents,
+            "pairs": pairs,
+            "think_seconds": think,
+            "gap_seconds": gap,
+            "remote_delay_seconds": delay,
+            "hook_seconds": hook_seconds,
+            "failures": sum(1 for item in items if not item["success"]),
+        }
+        for kind, prefix in (("first", "a"), ("back_to_back", "b")):
+            attempts = [item["transactions"] for item in items if item["id"].startswith(prefix)]
+            report[kind] = {
+                "writes": len(attempts),
+                "attempts_mean": round(statistics.mean(attempts), 3),
+                "redone_share": round(sum(1 for value in attempts if value > 1) / len(attempts), 3),
+            }
+        storage = GitStorage(str(remote), namespace=NAMESPACE, cache_dir=root / "audit")
+        with storage.read_snapshot():
+            graph = storage.load()
+            assert graph is not None
+            report["chain_valid"] = storage.events.verify_chain()[0]
+            report["replay_matches"] = (
+                verify(storage.events.read_all(), graph, storage.content) == []
+            )
+            report["nodes"] = len(graph.nodes)
+        return report
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--agents", type=int, default=8)
+    parser.add_argument("--pairs", type=int, default=8)
+    parser.add_argument(
+        "--think", type=float, default=30.0, help="random wait bound before each pair"
+    )
+    parser.add_argument("--gap", type=float, default=0.0, help="wait between a pair's writes")
+    parser.add_argument("--remote-delay", type=float, default=0.04)
+    parser.add_argument("--hook-seconds", type=float, default=0.2)
+    parser.add_argument("--runtime", type=Path, default=SRC, help="PYTHONPATH of the agents")
+    parser.add_argument("--no-yield", action="store_true")
+    parser.add_argument("--seed", type=int, default=1)
+    args = parser.parse_args()
+    os.environ.pop("CASCADE_GIT_LOG", None)
+    report = run(
+        args.agents,
+        args.pairs,
+        args.think,
+        args.gap,
+        args.remote_delay,
+        args.hook_seconds,
+        args.runtime,
+        args.no_yield,
+        args.seed,
+    )
+    print(json.dumps(report, indent=2, sort_keys=True))
+    healthy = (
+        report["failures"] == 0
+        and report["chain_valid"]
+        and report["replay_matches"]
+        and report["nodes"] == 2 * args.agents * args.pairs
+    )
+    return 0 if healthy else 1
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
