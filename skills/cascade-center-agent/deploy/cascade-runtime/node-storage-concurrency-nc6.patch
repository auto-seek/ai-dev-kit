+    bounds, sleeps = _record_backoff(monkeypatch)
+    started = time.monotonic()
+
+    with pytest.raises(LockContentionError):
+        contender.acquire(timeout=1.0, poll_interval=0.4, max_poll_interval=2.0)
+
