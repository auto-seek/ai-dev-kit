+    )
+    _git(remote, "update-ref", _heartbeat_ref("task"), garbage)
+    reader = _client(remote, tmp_path / "reader")
+
+    listed = reader.nodes()
+    checked = reader.check("task")
+
+    errors = listed.data["heartbeat_errors"]
+    assert [(e["key"], e["ref"], e["oid"]) for e in errors] == [
+        (heartbeat_key("task"), _heartbeat_ref("task"), garbage)
+    ]
+    assert "payload is invalid" in errors[0]["reason"]
+    assert "malformed heartbeat" in listed.message
+    assert checked.data["heartbeat_errors"] == errors
+    assert "malformed" in checked.message
+    time.sleep(1.2)
+    assert [r["task_id"] for r in reader.check_timeouts().data["released"]] == ["task"]
+    assert worker.renew("task", agent_id="agent-a", token=token).code in (
+        ErrorCode.TASK_NOT_ACTIVE,
+        ErrorCode.STALE_TOKEN,
+    )
