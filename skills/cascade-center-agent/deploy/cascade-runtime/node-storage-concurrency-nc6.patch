+def test_read_snapshot_and_queries_never_push_or_change_refs(
+    remote: Path, seeded: CascadeClient, tmp_path: Path, monkeypatch: pytest.MonkeyPatch
+) -> None:
+    before = remote_refs(remote)
+    commits = commit_count(remote, STATE_REF)
+    pushes = tmp_path / "push-attempts.log"
+    # Any push attempt, accepted or not, would be recorded and refused.
+    _install_hook(remote, "pre-receive", f'cat >> "{pushes}"\nexit 1\n')
+    log = tmp_path / "git.log"
+    monkeypatch.setenv("PATH", f"{install_git_counter(tmp_path / 'bin')}:{os.environ['PATH']}")
+    monkeypatch.setenv("CASCADE_GIT_LOG", str(log))
+
+    storage = _storage(remote, tmp_path / "observer")
+    client = CascadeClient(storage)
+    first_ts = client.history().data["events"][0]["logical_ts"]
+    assert client.nodes().success
+    assert client.check("beta").data["valid"] is True
+    assert client.history(node_id="beta").success
+    assert client.show(first_ts).success
+    assert client.diff(first_ts, first_ts + 10**12).success
+    assert client.snapshot_at(first_ts).success
+    assert set(client.load().nodes) == {"alpha", "beta"}
+    with storage.read_snapshot():
+        graph = storage.load()
+        assert graph is not None
+        assert storage.events.verify_chain()[0]
+        assert verify(storage.events.read_all(), graph, storage.content) == []
+        token = storage.tokens.check("beta")
+        assert token is not None and token.valid
+
+    assert remote_refs(remote) == before
+    assert LOCK_REF not in before
+    assert commit_count(remote, STATE_REF) == commits
+    assert not pushes.exists()
+    assert remote_calls(log)["push"] == 0
+
