+"""Real bare Git remotes, agent processes and remote-call counters for tests.
+
+Agents run in separate interpreters with an explicit ``PYTHONPATH`` so the
+same script can drive this checkout or an unchanged released runtime. The git
+counter is a wrapper placed first on ``PATH``; it records argv only while
+``CASCADE_GIT_LOG`` is set, so a process can count one operation precisely.
+"""
+
+from __future__ import annotations
+
+import json
+import os
+import shutil
+import subprocess
+import sys
+import zipfile
+from collections import Counter
+from pathlib import Path
+from typing import Any
+
+REPO_ROOT = Path(__file__).resolve().parents[1]
+SRC = REPO_ROOT / "src"
+REMOTE_SUBCOMMANDS = ("ls-remote", "fetch", "push")
+CONTENTION_MESSAGES = ("Could not acquire", "is held by", "changed while acquisition")
+
+
+def make_remote(path: Path) -> Path:
+    """A bare coordination remote configured as docs/git-storage.md requires.
+
+    Automatic maintenance after each push is off: a detached repack running
+    beside concurrent pushes was seen to drop a just-referenced object.
+    """
+    subprocess.run(
+        ["git", "init", "--bare", "--quiet", str(path)],
+        check=True,
+        capture_output=True,
+        text=True,
+    )
+    subprocess.run(["git", "--git-dir", str(path), "config", "receive.autogc", "false"], check=True)
+    return path
+
+
+def remote_refs(remote: Path) -> dict[str, str]:
+    """Every ref of a bare remote, read directly rather than through a client."""
+    listed = subprocess.run(
+        ["git", "--git-dir", str(remote), "for-each-ref", "--format=%(objectname) %(refname)"],
+        check=True,
+        capture_output=True,
+        text=True,
+    ).stdout
+    return {name: oid for oid, name in (line.split() for line in listed.splitlines())}
+
+
+def git_blob(remote: Path, oid: str, path: str) -> str:
+    return subprocess.run(
+        ["git", "--git-dir", str(remote), "show", f"{oid}:{path}"],
+        check=True,
+        capture_output=True,
+        text=True,
+    ).stdout
+
+
+def commit_count(remote: Path, ref: str) -> int:
+    return int(
+        subprocess.run(
+            ["git", "--git-dir", str(remote), "rev-list", "--count", ref],
+            check=True,
+            capture_output=True,
+            text=True,
+        ).stdout
+    )
+
+
+def install_git_counter(bin_dir: Path) -> Path:
+    """Write a ``git`` wrapper that logs argv while ``CASCADE_GIT_LOG`` is set."""
+    real_git = shutil.which("git")
+    assert real_git is not None, "git must be installed"
+    bin_dir.mkdir(parents=True, exist_ok=True)
+    wrapper = bin_dir / "git"
+    wrapper.write_text(
+        "#!/bin/bash\n"
+        'if [ -n "$CASCADE_GIT_LOG" ]; then\n'
+        '  line=""\n'
+        '  for arg in "$@"; do line+="$arg"$\'\\037\'; done\n'
+        '  printf \'%s\\n\' "$line" >> "$CASCADE_GIT_LOG"\n'
+        "fi\n"
+        f'exec "{real_git}" "$@"\n',
+        encoding="utf-8",
+    )
+    wrapper.chmod(0o755)
+    return bin_dir
+
+
+def remote_calls(log: Path) -> Counter[str]:
+    """Count logged ls-remote/fetch/push invocations; local git calls are ignored."""
+    counts: Counter[str] = Counter()
+    if not log.exists():
+        return counts
+    for line in log.read_text(encoding="utf-8").splitlines():
+        args = [arg for arg in line.split("\x1f") if arg]
+        index = 0
+        while index < len(args) and args[index] in ("-C", "--git-dir", "-c"):
+            index += 2
+        if index < len(args) and args[index] in REMOTE_SUBCOMMANDS:
+            counts[args[index]] += 1
+    return counts
+
+
+# One agent process: build GitStorage from a JSON spec, run its ops, print JSON.
+AGENT = r"""
+import json
+import os
+import sys
+import time
+from pathlib import Path
+
+import cascade
+from cascade.client import CascadeClient
+from cascade.storage.git_storage import GitStorage
+
+spec = json.loads(sys.argv[1])
+contention = tuple(spec["contention"])
+# For example the writer identity a receive hook reads (CASCADE_WRITER_AGENT).
+os.environ.update(spec.get("env", {}))
+if spec.get("no_yield") and hasattr(GitStorage, "_yield_to_redos"):
+    # Benchmarks compare against writes that never yield after their own publish.
+    GitStorage._yield_to_redos = lambda self: None
+
+
+def storage_for(cache):
+    return GitStorage(
+        spec["remote"], namespace=spec["namespace"], cache_dir=cache, **spec.get("storage", {})
+    )
+
+
+def first_storage():
+    # Processes sharing one cache wait for its local lock; that is contention.
+    from cascade.errors import LockContentionError
+
+    deadline = time.monotonic() + spec.get("deadline", 120)
+    while True:
+        try:
+            return storage_for(spec["cache"])
+        except LockContentionError:
+            if time.monotonic() > deadline:
+                raise
+            time.sleep(0.1)
+
+
+if spec.get("construction_log"):
+    # Count what constructing the storage costs, together with the first op.
+    os.environ["CASCADE_GIT_LOG"] = spec["construction_log"]
+storage = first_storage()
+client = CascadeClient(storage)
+out = {"version": cascade.__version__, "file": cascade.__file__, "results": []}
+held = {}
+transactions = [0]
+real_lock = storage.lock
+
+
+def counting_lock(*args, **kwargs):
+    transactions[0] += 1
+    return real_lock(*args, **kwargs)
+
+
+storage.lock = counting_lock
+
+
+def until_uncontended(call):
+    deadline = time.monotonic() + spec.get("deadline", 120)
+    attempts = 0
+    while True:
+        attempts += 1
+        result = call()
+        if result.success or not any(text in result.message for text in contention):
+            return result, attempts
+        if time.monotonic() > deadline:
+            return result, attempts
+        time.sleep(0.02)
+
+
+for op in spec["ops"]:
+    kind = op["op"]
+    if op.get("log"):
+        os.environ["CASCADE_GIT_LOG"] = op["log"]
+    before = (len(out["results"]), transactions[0])
+    try:
+        if kind == "add":
+            result, attempts = until_uncontended(
+                lambda: client.add(op["id"], op_id="add-" + op["id"])
+            )
+            out["results"].append(
+                {"op": kind, "id": op["id"], "success": result.success, "code": result.code,
+                 "message": result.message, "attempts": attempts}
+            )
+        elif kind == "nodes":
+            result = client.nodes()
+            ids = sorted(node["id"] for node in result.data["nodes"])
+            out["results"].append(
+                {"op": kind, "success": result.success, "message": result.message, "ids": ids}
+            )
+        elif kind == "foreign_add":
+            other = CascadeClient(storage_for(op["cache"]))
+            result = other.add(op["id"])
+            out["results"].append({"op": kind, "success": result.success, "message": result.message})
+        elif kind == "hold":
+            with storage.lock():
+                Path(op["marker"]).touch()
+                time.sleep(op["seconds"])
+            out["results"].append({"op": kind, "success": True})
+        elif kind == "claim":
+            started = time.monotonic()
+            result, attempts = until_uncontended(
+                lambda: client.claim(
+                    op["agent"], op.get("task_id"), agent_tier=op.get("agent_tier"),
+                    timeout=op.get("timeout"),
+                )
+            )
+            seconds = time.monotonic() - started
+            if result.success:
+                held[op["agent"]] = (result.data["task_id"], result.data["token"])
+            out["results"].append(
+                {"op": kind, "success": result.success, "code": result.code,
+                 "message": result.message, "task_id": result.data.get("task_id"),
+                 "token": result.data.get("token"), "seconds": seconds, "attempts": attempts}
+            )
+        elif kind in ("renew", "complete") and op["agent"] not in held and "token" not in op:
+            out["results"].append(
+                {"op": kind, "success": False, "code": "NO_CLAIM", "message": "claim failed",
+                 "seconds": 0.0}
+            )
+        elif kind == "renew":
+            task_id, token = held.get(op["agent"]) or (op["task_id"], op["token"])
+            for _ in range(op.get("times", 1)):
+                time.sleep(op.get("interval", 0))
+                started = time.monotonic()
+                result = client.renew(task_id, agent_id=op["agent"], token=token)
+                out["results"].append(
+                    {"op": kind, "success": result.success, "code": result.code,
+                     "message": result.message, "seconds": time.monotonic() - started}
+                )
+        elif kind == "complete":
+            task_id, token = held.pop(op["agent"], None) or (op["task_id"], op["token"])
+            started = time.monotonic()
+            result, attempts = until_uncontended(
+                lambda: client.complete(
+                    task_id, agent_id=op["agent"], token=token, op_id=f"done-{task_id}-{token}"
+                )
+            )
+            out["results"].append(
+                {"op": kind, "success": result.success, "code": result.code,
+                 "message": result.message, "task_id": task_id,
+                 "seconds": time.monotonic() - started}
+            )
+        elif kind == "check_timeouts":
+            result = client.check_timeouts()
+            released = [item["task_id"] for item in result.data.get("released", [])]
+            out["results"].append(
+                {"op": kind, "success": result.success, "message": result.message,
+                 "released": released}
+            )
+        elif kind == "audit":
+            from cascade.replay import verify
+
+            with storage.read_snapshot():
+                graph = storage.load()
+                chain = storage.events.verify_chain()
+                diffs = verify(storage.events.read_all(), graph, storage.content)
+            out["results"].append(
+                {"op": kind, "success": bool(chain[0]) and not diffs, "chain": list(chain),
+                 "diffs": [str(diff) for diff in diffs],
+                 "states": {key: node.state.name for key, node in graph.nodes.items()}}
+            )
+        elif kind == "sleep":
+            time.sleep(op["seconds"])
+        elif kind == "stall_in_transaction":
+            with storage.lock():
+                graph = storage.load()
+                Path(op["marker"]).touch()
+                time.sleep(600)
+        elif kind == "try_lock":
+            from cascade.errors import LockContentionError
+
+            try:
+                with storage.lock(blocking=False):
+                    pass
+                contended = False
+            except LockContentionError:
+                contended = True
+            out["results"].append({"op": kind, "contended": contended})
+        elif kind == "wait_for":
+            deadline = time.monotonic() + 300
+            while not Path(op["marker"]).exists():
+                if time.monotonic() > deadline:
+                    raise SystemExit("marker never appeared: " + op["marker"])
+                time.sleep(0.01)
+        else:
+            raise SystemExit("unknown op " + kind)
+    finally:
+        os.environ.pop("CASCADE_GIT_LOG", None)
+        if len(out["results"]) == before[0] + 1:
+            out["results"][-1]["transactions"] = transactions[0] - before[1]
+
+print(json.dumps(out))
+"""
+
+
+def extract_runtime(wheel: str | Path, version: str, target: Path) -> Path:
+    """Unpack a pure-Python wheel for use as an agent's PYTHONPATH; check its version."""
+    with zipfile.ZipFile(wheel) as archive:
+        archive.extractall(target)
+    metadata = next(target.glob("cascade_auto-*.dist-info/METADATA")).read_text(encoding="utf-8")
+    assert f"\nVersion: {version}\n" in metadata, f"{wheel} is not {version}"
+    return target
+
+
+def agent_env(runtime: Path, path_prefix: Path | None = None) -> dict[str, str]:
+    env = os.environ.copy()
+    env["PYTHONPATH"] = str(runtime)
+    env.pop("CASCADE_GIT_LOG", None)
+    if path_prefix is not None:
+        env["PATH"] = f"{path_prefix}{os.pathsep}{env['PATH']}"
+    return env
+
+
+def start_agent(
+    runtime: Path,
+    spec: dict[str, Any],
+    *,
+    path_prefix: Path | None = None,
+) -> subprocess.Popen[str]:
+    full = {"contention": list(CONTENTION_MESSAGES), **spec}
+    return subprocess.Popen(
+        [sys.executable, "-c", AGENT, json.dumps(full)],
+        cwd=REPO_ROOT,
+        env=agent_env(runtime, path_prefix),
+        text=True,
+        stdout=subprocess.PIPE,
+        stderr=subprocess.PIPE,
+    )
+
+
+def finish_agent(process: subprocess.Popen[str], timeout: float = 180) -> dict[str, Any]:
+    stdout, stderr = process.communicate(timeout=timeout)
+    assert process.returncode == 0, f"agent failed ({process.returncode}): {stderr}"
+    result: dict[str, Any] = json.loads(stdout.strip().splitlines()[-1])
+    return result
+
+
+def run_agent(
+    runtime: Path,
+    spec: dict[str, Any],
+    *,
+    path_prefix: Path | None = None,
+) -> dict[str, Any]:
+    return finish_agent(start_agent(runtime, spec, path_prefix=path_prefix))
