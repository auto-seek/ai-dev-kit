+class _RecordingTime:
+    """``time`` for git_storage with real clocks and recorded sleeps."""
+
+    def __init__(self) -> None:
+        self.sleeps: list[float] = []
+        self.time = time.time
+        self.monotonic = time.monotonic
+
+    def sleep(self, seconds: float) -> None:
+        self.sleeps.append(seconds)
+        time.sleep(seconds)
+
+
+def test_a_write_right_after_publishing_yields_to_writers_that_lost_to_it(
+    remote: Path, seeded: CascadeClient, tmp_path: Path, monkeypatch: pytest.MonkeyPatch
+) -> None:
+    from cascade.storage import git_storage
+
+    storage = _storage(remote, tmp_path / "writer")
+    client = CascadeClient(storage)
+    other = _client(remote, tmp_path / "other")
+    assert client.add("mine-1").success
+    assert other.add("theirs").success
+    # Built on another writer's commit: losers of this publish may be redoing.
+    assert client.add("mine-2").success
+    record = tmp_path / "writer" / "git-state.published"
+    published = json.loads(record.read_text())
+    assert published["others"] is True and published["seconds"] > 0
+    # This write starts 0.2 s after the publish of an attempt that took 1 s.
+    published.update(at=time.time() - 0.2, seconds=1.0)
+    record.write_text(json.dumps(published))
+    clock = _RecordingTime()
+    monkeypatch.setattr(git_storage, "time", clock)
+
+    assert client.add("mine-3").success
+
+    assert len(clock.sleeps) == 1
+    assert 0.7 < clock.sleeps[0] <= 1.0 + git_storage._YIELD_MARGIN - 0.2
+
+
+@pytest.mark.parametrize(
+    ("elapsed", "seconds", "others", "expected"),
+    [
+        (0.01, 0.5, True, None),  # ahead of the losers' redos
+        (0.2, 0.5, True, 0.35),
+        (1.0, 0.5, True, None),  # their redos had time to land
+        (0.2, 0.5, False, None),  # nobody else was writing
+        (0.2, 10.0, True, 1.85),  # at most _YIELD_MAX
+        (-5.0, 0.5, True, None),  # clock moved back
+    ],
+)
+def test_the_yield_after_a_publish_depends_on_elapsed_time_and_other_writers(
+    tmp_path: Path,
+    monkeypatch: pytest.MonkeyPatch,
+    elapsed: float,
+    seconds: float,
+    others: bool,
+    expected: float | None,
+) -> None:
+    from cascade.storage import git_storage
+
+    storage = GitStorage("unused-remote", namespace="ns", cache_dir=tmp_path / "cache")
+    now = 1_000_000.0
+    record = {"oid": "0" * 40, "at": now - elapsed, "seconds": seconds, "others": others}
+    (tmp_path / "cache" / "git-state.published").write_text(json.dumps(record))
+    sleeps: list[float] = []
+    monkeypatch.setattr(
+        git_storage, "time", type("Clock", (), {"time": lambda: now, "sleep": sleeps.append})
+    )
+
+    storage._yield_to_redos()
+
+    assert sleeps == ([] if expected is None else [pytest.approx(expected)])
+
+
+def test_a_lone_writer_and_a_redo_never_yield(
+    remote: Path, seeded: CascadeClient, tmp_path: Path, monkeypatch: pytest.MonkeyPatch
+) -> None:
+    from cascade.storage import git_storage
+
+    storage = _storage(remote, tmp_path / "writer")
+    client = CascadeClient(storage)
+    assert client.add("first").success
+    time.sleep(
+        json.loads((tmp_path / "writer" / "git-state.published").read_text())["seconds"] + 0.1
+    )
+    assert client.add("second").success  # its base is this cache's own commit
+    assert json.loads((tmp_path / "writer" / "git-state.published").read_text())["others"] is False
+    clock = _RecordingTime()
+    monkeypatch.setattr(git_storage, "time", clock)
+    assert client.add("third").success
+    assert clock.sleeps == []
+
+    # A redo follows a lost compare-and-swap, not a publish of this cache, so
+    # it never waits, even after a publish that had other writers around. The
+    # other writer runs in its own process; only this storage's waits count.
+    def other_add(node_id: str) -> None:
+        result = run_agent(
+            SRC, _spec(remote, tmp_path / "intruder", [{"op": "add", "id": node_id}])
+        )
+        assert result["results"][0]["success"], result
+
+    other_add("theirs")
+    assert client.add("mine").success
+    published = json.loads((tmp_path / "writer" / "git-state.published").read_text())
+    assert published["others"] is True
+    time.sleep(published["seconds"] + 0.1)
+    real_commit = storage._commit_state
+    attempts: list[int] = []
+
+    def race_then_commit() -> str | None:
+        attempts.append(1)
+        if len(attempts) == 1:
+            other_add("intruder")
+        return real_commit()
+
+    monkeypatch.setattr(storage, "_commit_state", race_then_commit)
+    clock.sleeps.clear()
+    assert client.add("fourth").success
+    assert len(attempts) == 2 and clock.sleeps == []
+
