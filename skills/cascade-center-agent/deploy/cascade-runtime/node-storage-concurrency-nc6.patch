+"""Per-claim heartbeat refs and lock-free writers on real bare Git remotes.
+
+Perspective: twenty agents renewing, claiming and completing at once.
+Invariant: a renewal changes only its own heartbeat ref; every expiry decision
+uses max(claimed_at, heartbeat renewed_at) of the current claim; ended claims
+lose their heartbeat in the same atomic push; a lost compare-and-swap is redone
+on fresh state; a client that dies mid-write leaves nothing for others to wait on.
+Goal: renewals and writes that do not serialize on a global lock and never
+reclaim a live claim.
+Migration: integration evidence for 0.8.2+nodecollab.3 and later.
+"""
+
+from __future__ import annotations
+
+import dataclasses
+import json
+import os
+import signal
+import subprocess
+import time
+from pathlib import Path
+from typing import Any
+
+import pytest
+from git_remote_kit import (
+    SRC,
+    commit_count,
+    finish_agent,
+    install_git_counter,
+    make_remote,
+    remote_calls,
+    remote_refs,
+    start_agent,
+)
+from test_task_input_publication import task_input
+
+from cascade.client import CascadeClient
+from cascade.errors import LockError, StateConflictError
+from cascade.events import EventType
+from cascade.replay import replay, verify
+from cascade.storage.git_storage import GitStorage
+from cascade.types import ErrorCode, Heartbeat, heartbeat_key
+
+NAMESPACE = "beat"
+STATE_REF = f"refs/heads/cascade-state/{NAMESPACE}"
+
+
+def _storage(remote: Path, cache: Path) -> GitStorage:
+    return GitStorage(str(remote), namespace=NAMESPACE, cache_dir=cache)
+
+
+def _client(remote: Path, cache: Path) -> CascadeClient:
+    return CascadeClient(_storage(remote, cache))
+
+
+def _spec(remote: Path, cache: Path, ops: list[dict[str, Any]]) -> dict[str, Any]:
+    return {"remote": str(remote), "namespace": NAMESPACE, "cache": str(cache), "ops": ops}
+
+
+def _heartbeat_ref(task_id: str) -> str:
+    return f"refs/heads/cascade-heartbeat/{NAMESPACE}/{heartbeat_key(task_id)}"
+
+
+def _git(remote: Path, *args: str, stdin: str | None = None) -> str:
+    return subprocess.run(
+        ["git", "--git-dir", str(remote), *args],
+        input=stdin,
+        check=True,
+        capture_output=True,
+        text=True,
+    ).stdout.strip()
+
+
+def _payload(remote: Path, task_id: str) -> dict[str, Any]:
+    oid = remote_refs(remote)[_heartbeat_ref(task_id)]
+    result: dict[str, Any] = json.loads(_git(remote, "show", "-s", "--format=%B", oid))
+    return result
+
+
+def _states(client: CascadeClient) -> dict[str, dict[str, Any]]:
+    listed = client.nodes()
+    assert listed.success, listed.message
+    return {node["id"]: node for node in listed.data["nodes"]}
+
+
+@pytest.fixture
+def remote(tmp_path: Path) -> Path:
+    return make_remote(tmp_path / "remote.git")
+
+
+def test_claim_creates_a_heartbeat_and_renewal_pushes_only_that_ref(
+    remote: Path, tmp_path: Path, monkeypatch: pytest.MonkeyPatch
+) -> None:
+    assert _client(remote, tmp_path / "publisher").add("task").success
+    worker = _client(remote, tmp_path / "worker")
+    claim = worker.claim("agent-a", "task", timeout=60)
+    token = claim.data["token"]
+    created = remote_refs(remote)[_heartbeat_ref("task")]
+    first = _payload(remote, "task")
+    assert first == {
+        "namespace": NAMESPACE,
+        "task_id": "task",
+        "agent_id": "agent-a",
+        "claim_token": token,
+        "renewed_at": first["renewed_at"],
+        "timeout": 60.0,
+        "runtime": "0.8.2+nodecollab.6",
