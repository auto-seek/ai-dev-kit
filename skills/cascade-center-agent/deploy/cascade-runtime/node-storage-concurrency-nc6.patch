+def test_concurrent_writer_processes_lose_no_updates(
+    remote: Path, seeded: CascadeClient, tmp_path: Path
+) -> None:
+    commits_before = commit_count(remote, STATE_REF)
+    expected = {f"p{index}-{step}" for index in range(6) for step in range(4)}
+    agents = [
+        start_agent(
+            SRC,
+            _spec(
+                remote,
+                tmp_path / f"agent-{index}",
+                [{"op": "add", "id": f"p{index}-{step}"} for step in range(4)],
+            ),
+        )
+        for index in range(6)
+    ]
+    results = [finish_agent(agent) for agent in agents]
+
+    failures = [item for result in results for item in result["results"] if not item["success"]]
+    assert failures == []
+    storage = _storage(remote, tmp_path / "auditor")
+    with storage.read_snapshot():
+        graph = storage.load()
+        assert graph is not None
+        events = storage.events.read_all()
+        assert storage.events.verify_chain() == (True, "")
+        assert verify(events, graph, storage.content) == []
+    assert set(graph.nodes) == expected | {"alpha", "beta"}
+    assert len(events) == 3 + len(expected)
+    # One state commit per accepted write: no lost or duplicated publication.
+    assert commit_count(remote, STATE_REF) == commits_before + len(expected)
+    assert LOCK_REF not in remote_refs(remote)
