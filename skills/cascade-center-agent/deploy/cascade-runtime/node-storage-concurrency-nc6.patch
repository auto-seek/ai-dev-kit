+"""This runtime beside released nodecollab.3 and .5, and behind a center guard.
+
+Perspective: a center whose guard and publisher run nodecollab.3 while agents
+move to this runtime one by one.
+Invariant: both runtimes write the same heartbeat and state formats (only the
+runtime marker differs), honour each other's heartbeats, contend on the same
+refs without losing writes, and pass the center's receive guard.
+Goal: prove the client upgrade needs no server change.
+Migration: needs ``CASCADE_NODECOLLAB3_WHEEL``; the guard cases also need
+``CASCADE_CENTER_GUARD``, the path of CascadeCenter-web's
+``scripts/cascade-node-receive.py``, which runs here on the nodecollab.3 wheel;
+the nodecollab.5 cases need ``CASCADE_NODECOLLAB5_WHEEL``.
+"""
+
+from __future__ import annotations
+
+import json
+import os
+import subprocess
+import sys
+import time
+from pathlib import Path
+from typing import Any
+
+import pytest
+from git_remote_kit import (
+    SRC,
+    extract_runtime,
+    finish_agent,
+    git_blob,
+    make_remote,
+    remote_refs,
+    run_agent,
+    start_agent,
+)
+
+import cascade
+from cascade.client import CascadeClient
+from cascade.storage.git_storage import GitStorage
+from cascade.types import heartbeat_key
+
+NC3 = "0.8.2+nodecollab.3"
+NC5 = "0.8.2+nodecollab.5"
+NAMESPACE = "interop"
+STATE_REF = f"refs/heads/cascade-state/{NAMESPACE}"
+HEARTBEAT_PREFIX = f"refs/heads/cascade-heartbeat/{NAMESPACE}/"
+CENTER = "center-1"
+TIER = "pro"
+EMPTY_TREE = "4b825dc642cb6eb9a060e54bf8d69288fbee4904"
+
+
+@pytest.fixture(scope="module")
+def nc3_runtime(tmp_path_factory: pytest.TempPathFactory) -> Path:
+    wheel = os.environ.get("CASCADE_NODECOLLAB3_WHEEL")
+    if not wheel:
+        pytest.skip(f"set CASCADE_NODECOLLAB3_WHEEL to the {NC3} wheel")
+    return extract_runtime(wheel, NC3, tmp_path_factory.mktemp("nodecollab-3"))
+
+
+@pytest.fixture(scope="module")
+def nc5_runtime(tmp_path_factory: pytest.TempPathFactory) -> Path:
+    wheel = os.environ.get("CASCADE_NODECOLLAB5_WHEEL")
+    if not wheel:
+        pytest.skip(f"set CASCADE_NODECOLLAB5_WHEEL to the {NC5} wheel")
+    return extract_runtime(wheel, NC5, tmp_path_factory.mktemp("nodecollab-5"))
+
+
+@pytest.fixture(scope="module")
+def center_guard() -> Path:
+    guard = os.environ.get("CASCADE_CENTER_GUARD")
+    if not guard:
+        pytest.skip("set CASCADE_CENTER_GUARD to CascadeCenter-web's cascade-node-receive.py")
+    return Path(guard)
+
+
+def _spec(
+    remote: Path, cache: Path, ops: list[dict[str, Any]], writer: str | None = None
+) -> dict[str, Any]:
+    spec: dict[str, Any] = {
+        "remote": str(remote),
+        "namespace": NAMESPACE,
+        "cache": str(cache),
+        "ops": ops,
+    }
+    if writer is not None:
+        spec["env"] = {"CASCADE_WRITER_AGENT": writer}
+    return spec
+
+
+def _client(remote: Path, cache: Path) -> CascadeClient:
+    return CascadeClient(GitStorage(str(remote), namespace=NAMESPACE, cache_dir=cache))
+
+
+def _seed(remote: Path, cache: Path, *task_ids: str) -> None:
+    # Before any guard: the guard refuses to create the center state.
+    client = _client(remote, cache)
+    for task_id in task_ids:
+        assert client.add(task_id).success
+
+
+def _install_guard(remote: Path, guard: Path, runtime: Path, root: Path, agents: list[str]) -> Path:
+    """The center's receive guard as pre-receive hook, on the nodecollab.3 runtime.
+
+    It runs switched (``--require-runtime``), the strictest mode, with
+    incremental verification from checkpoints. Returns the checkpoint directory.
+    """
+    registry = root / "registry.json"
+    registry.write_text(
+        json.dumps([{"id": agent, "tier": TIER, "centers": [CENTER]} for agent in agents]),
+        encoding="utf-8",
+    )
+    checkpoints = root / "checkpoints"
+    checkpoints.mkdir(mode=0o700)
+    hook = remote / "hooks" / "pre-receive"
+    hook.write_text(
+        "#!/bin/sh\n"
+        f"PYTHONPATH='{runtime}' exec '{sys.executable}' '{guard}' --registry '{registry}' "
+        f"--center {CENTER} --namespace {NAMESPACE} --checkpoint-dir '{checkpoints}' "
+        "--require-runtime\n",
+        encoding="utf-8",
+    )
+    hook.chmod(0o755)
+    return checkpoints
+
+
+def _heartbeat_refs(remote: Path) -> list[str]:
+    return [ref for ref in remote_refs(remote) if ref.startswith(HEARTBEAT_PREFIX)]
+
+
+def _runtime_markers(remote: Path) -> set[str]:
+    log = subprocess.run(
+        ["git", "--git-dir", str(remote), "log", "--format=%B", STATE_REF],
+        check=True,
+        capture_output=True,
+        text=True,
+    ).stdout
+    return {line[len("runtime=") :] for line in log.splitlines() if line.startswith("runtime=")}
+
+
+def _audit(runtime: Path, remote: Path, cache: Path) -> dict[str, Any]:
+    """Chain and replay verification from inside an agent of ``runtime``."""
+    result = run_agent(runtime, _spec(remote, cache, [{"op": "audit"}]))["results"][0]
+    assert result["success"], result
+    states: dict[str, Any] = result["states"]
+    return states
+
+
+def _cat(remote: Path, oid: str) -> str:
+    return subprocess.run(
+        ["git", "--git-dir", str(remote), "cat-file", "-p", oid],
+        check=True,
+        capture_output=True,
+        text=True,
+    ).stdout
+
+
+def _shape(value: Any) -> Any:
+    """The JSON structure of ``value`` with leaves replaced by their type."""
+    if isinstance(value, dict):
+        return {key: _shape(item) for key, item in sorted(value.items())}
+    if isinstance(value, list):
+        return [_shape(item) for item in value]
+    return type(value).__name__
+
+
+def _artifacts(remote: Path, runtime: Path, root: Path) -> dict[str, Any]:
+    """Objects one claim, renewal and completion of ``runtime`` leave on a fresh remote."""
+    _seed(remote, root / "seed", "task")
+    claimed = run_agent(
+        runtime,
+        _spec(
+            remote,
+            root / "agent",
+            [
+                {"op": "claim", "agent": "agent-a", "task_id": "task", "timeout": 60},
+                {"op": "renew", "agent": "agent-a"},
+            ],
+        ),
+    )
+    claim, renewal = claimed["results"]
+    assert claim["success"] and renewal["success"], claimed
+    refs = remote_refs(remote)
+    heartbeat = next(oid for ref, oid in refs.items() if ref.startswith(HEARTBEAT_PREFIX))
+    claim_state = refs[STATE_REF]
+    done = run_agent(
+        runtime,
+        _spec(
+            remote,
+            root / "agent",
+            [{"op": "complete", "agent": "agent-a", "task_id": "task", "token": claim["token"]}],
+        ),
+    )
+    assert done["results"][0]["success"], done
+    state = remote_refs(remote)[STATE_REF]
+    tree = subprocess.run(
+        ["git", "--git-dir", str(remote), "ls-tree", "-r", "--name-only", state],
+        check=True,
+        capture_output=True,
+        text=True,
+    ).stdout.split()
+    events = [
+        json.loads(line) for line in git_blob(remote, state, "data/events.jsonl").splitlines()
+    ]
+    return {
+        "version": claimed["version"],
+        "heartbeat": _cat(remote, heartbeat),
+        "claim_commit": _cat(remote, claim_state),
+        "state_commit": _cat(remote, state),
+        "tree": sorted(tree),
+        "graph": json.loads(git_blob(remote, state, "data/graph.json")),
+        "events": events,
+        "ops": json.loads(git_blob(remote, state, "data/ops.json")),
+        "heartbeats_left": _heartbeat_refs(remote),
+    }
+
+
+def _headers(commit: str) -> tuple[list[str], str]:
+    header, _, message = commit.partition("\n\n")
+    return [line.split(" ", 1)[0] for line in header.splitlines()], message
+
+
+def test_heartbeat_and_state_formats_match_nodecollab3(nc3_runtime: Path, tmp_path: Path) -> None:
+    old = _artifacts(make_remote(tmp_path / "nc3.git"), nc3_runtime, tmp_path / "nc3")
+    new = _artifacts(make_remote(tmp_path / "nc5.git"), SRC, tmp_path / "nc5")
+    assert (old["version"], new["version"]) == (NC3, cascade.__version__)
+
+    # Heartbeat: empty tree, one parent (the claim's heartbeat), compact
+    # sorted JSON with the same keys and types; only the runtime differs.
+    payloads = []
+    for found in (old, new):
+        fields, message = _headers(found["heartbeat"])
+        assert fields == ["tree", "parent", "author", "committer"]
+        assert found["heartbeat"].startswith(f"tree {EMPTY_TREE}\n")
+        payload = json.loads(message)
+        assert message == json.dumps(payload, sort_keys=True, separators=(",", ":"))
+        payloads.append(payload)
+    assert _shape(payloads[0]) == _shape(payloads[1])
+    assert [payload.pop("runtime") for payload in payloads] == [NC3, cascade.__version__]
+    assert {
+        key: value for key, value in payloads[0].items() if key not in ("renewed_at", "claim_token")
+    } == {
+        key: value for key, value in payloads[1].items() if key not in ("renewed_at", "claim_token")
+    }
+
+    # State commits: same header fields and message lines; runtime differs.
+    for key in ("claim_commit", "state_commit"):
+        shapes = []
+        for found in (old, new):
+            fields, message = _headers(found[key])
+            lines = message.splitlines()
+            shapes.append(
+                (fields, lines[0], lines[1], [line.split("=", 1)[0] for line in lines[2:]])
+            )
+            assert f"runtime={found['version']}" in lines
+        assert shapes[0] == shapes[1]
+        assert shapes[0][2:] == ("", ["holder", "runtime", "created_at"])
+
+    # Published data: same files, same JSON structure, same events.
+    assert old["tree"] == new["tree"]
+    assert _shape(old["graph"]) == _shape(new["graph"])
+    assert _shape(old["ops"]) == _shape(new["ops"])
+    assert [(event["type"], _shape(event)) for event in old["events"]] == [
+        (event["type"], _shape(event)) for event in new["events"]
+    ]
+    assert old["heartbeats_left"] == new["heartbeats_left"] == []
+
+
+def test_heartbeats_of_either_runtime_extend_the_lease_for_the_other(
+    nc3_runtime: Path, tmp_path: Path
+) -> None:
+    remote = make_remote(tmp_path / "remote.git")
+    _seed(remote, tmp_path / "seed", "five", "three")
+    lease = 12.0
+    renew_now = tmp_path / "renew-now"
+    # nodecollab.3 claims "three"; once this runtime has claimed "five", both
+    # renew five seconds later.
+    old_agent = start_agent(
+        nc3_runtime,
+        _spec(
+            remote,
+            tmp_path / "nc3-agent",
+            [
+                {"op": "claim", "agent": "agent-3", "task_id": "three", "timeout": lease},
+                {"op": "wait_for", "marker": str(renew_now)},
+                {"op": "renew", "agent": "agent-3"},
+            ],
+        ),
+    )
+    three_ref = HEARTBEAT_PREFIX + heartbeat_key("three")
+    deadline = time.monotonic() + 120
+    while three_ref not in remote_refs(remote):
+        assert time.monotonic() < deadline, "nodecollab.3 never claimed"
+        assert old_agent.poll() is None, finish_agent(old_agent)
+        time.sleep(0.05)
+    claim = _client(remote, tmp_path / "nc5-agent").claim("agent-5", "five", timeout=lease)
+    assert claim.success, claim.message
+    time.sleep(5)
+    renew_now.touch()
+    renewed = _client(remote, tmp_path / "nc5-agent").renew(
+        "five", agent_id="agent-5", token=claim.data["token"]
+    )
+    assert renewed.success, renewed.message
+    old = finish_agent(old_agent)
+    assert all(item["success"] for item in old["results"]), old
+
+    observer = _client(remote, tmp_path / "observer")
+    checks = {task: observer.check(task).data for task in ("five", "three")}
+    first_expiry = max(check["claimed_at"] for check in checks.values()) + lease
+    renewed_expiry = min(check["lease_expires_at"] for check in checks.values())
+    assert renewed_expiry > first_expiry + 3
+    assert checks["three"]["renewed_at"] > checks["three"]["claimed_at"]
+    assert checks["five"]["renewed_at"] == renewed.data["renewed_at"]
+
+    # Past the claims' own expiry, inside the renewed leases: neither runtime
+    # reclaims a claim the other one renewed.
+    time.sleep(max(0.0, first_expiry + 0.5 - time.time()))
+    checked = run_agent(
+        nc3_runtime, _spec(remote, tmp_path / "nc3-check", [{"op": "check_timeouts"}])
+    )
+    assert checked["results"][0]["released"] == []
+    assert observer.check_timeouts().data.get("released", []) == []
+    assert time.time() < renewed_expiry, "the host was too slow for this timing test"
+    assert _audit(nc3_runtime, remote, tmp_path / "nc3-check") == {
+        "five": "ACTIVE",
+        "three": "ACTIVE",
+    }
+
+    # Once the renewed leases end, nodecollab.3 releases both and deletes
+    # both heartbeats, including the one this runtime wrote.
+    last_expiry = max(check["lease_expires_at"] for check in checks.values())
+    time.sleep(max(0.0, last_expiry + 0.5 - time.time()))
+    released = run_agent(
+        nc3_runtime, _spec(remote, tmp_path / "nc3-check", [{"op": "check_timeouts"}])
+    )["results"][0]["released"]
+    assert sorted(released) == ["five", "three"]
+    assert _heartbeat_refs(remote) == []
+    assert _audit(SRC, remote, tmp_path / "observer") == {"five": "READY", "three": "READY"}
+
+
+def _mixed_run(remote: Path, root: Path, other: Path, agents: list[str]) -> list[dict[str, Any]]:
+    """Each agent claims, renews twice and completes its own task; plus one contested task.
+
+    Agents alternate between this runtime and ``other``.
+    """
+    processes = []
+    for index, agent in enumerate(agents):
+        runtime = other if index % 2 else SRC
+        ops = [
+            {
+                "op": "claim",
+                "agent": agent,
+                "task_id": f"own-{index}",
+                "agent_tier": TIER,
+                "timeout": 60,
+            },
+            {"op": "renew", "agent": agent, "times": 2, "interval": 0.5},
+            {"op": "complete", "agent": agent},
+        ]
+        if index < 2:
+            ops += [
+                {
+                    "op": "claim",
+                    "agent": agent,
+                    "task_id": "contested",
+                    "agent_tier": TIER,
+                    "timeout": 60,
+                },
+            ]
+        processes.append(
+            start_agent(runtime, _spec(remote, root / f"cache-{index}", ops, writer=agent))
+        )
+    return [finish_agent(process, timeout=300) for process in processes]
+
+
+def _share_a_center(
+    other: Path,
+    version: str,
+    guard_runtime: Path,
+    tmp_path: Path,
+    request: pytest.FixtureRequest,
+    guarded: bool,
+) -> None:
+    agents = [f"agent-{index}" for index in range(6)]
+    remote = make_remote(tmp_path / "remote.git")
+    _seed(remote, tmp_path / "seed", *(f"own-{index}" for index in range(6)), "contested")
+    checkpoints = None
+    if guarded:
+        guard = request.getfixturevalue("center_guard")
+        checkpoints = _install_guard(remote, guard, guard_runtime, tmp_path, agents)
+
+    results = _mixed_run(remote, tmp_path, other, agents)
+
+    assert {result["version"] for result in results} == {version, cascade.__version__}
+    for result in results:
+        assert all(item["success"] for item in result["results"][:4]), result
+    contested = [result["results"][4] for result in results[:2]]
+    assert sorted(item["success"] for item in contested) == [False, True], contested
+    winner = agents[[item["success"] for item in contested].index(True)]
+
+    states = _audit(other, remote, tmp_path / "other-audit")
+    assert states == {**{f"own-{index}": "COMPLETED" for index in range(6)}, "contested": "ACTIVE"}
+    assert _audit(SRC, remote, tmp_path / "this-audit") == states
+    assert len(_heartbeat_refs(remote)) == 1
+    assert _runtime_markers(remote) >= {version, cascade.__version__}
+    owner = _client(remote, tmp_path / "this-audit").check("contested").data
+    assert owner["agent_id"] == winner
+    if checkpoints is not None:
+        # The guard verified the pushes incrementally from saved checkpoints.
+        assert any(checkpoints.iterdir())
+
+
+@pytest.mark.parametrize("guarded", [False, True], ids=["plain-remote", "center-guard"])
+def test_nodecollab3_and_this_runtime_share_a_center(
+    nc3_runtime: Path, tmp_path: Path, request: pytest.FixtureRequest, guarded: bool
+) -> None:
+    _share_a_center(nc3_runtime, NC3, nc3_runtime, tmp_path, request, guarded)
+
+
+@pytest.mark.parametrize("guarded", [False, True], ids=["plain-remote", "center-guard"])
+def test_nodecollab5_and_this_runtime_share_a_center(
+    nc5_runtime: Path,
+    nc3_runtime: Path,
+    tmp_path: Path,
+    request: pytest.FixtureRequest,
+    guarded: bool,
+) -> None:
+    _share_a_center(nc5_runtime, NC5, nc3_runtime, tmp_path, request, guarded)
+
+
+def test_claims_move_between_nodecollab5_and_this_runtime_in_one_cache(
+    nc5_runtime: Path, tmp_path: Path
+) -> None:
+    """An agent upgraded or rolled back mid-claim keeps renewing and completing it.
+
+    The cache's own records differ between the two (this runtime adds a
+    publish record and keeps two chain heads); each must accept the other's.
+    """
+    remote = make_remote(tmp_path / "remote.git")
+    _seed(remote, tmp_path / "seed", "claimed-by-nc5", "claimed-by-this")
+    cache = tmp_path / "agent"
+
+    def step(runtime: Path, op: dict[str, Any]) -> dict[str, Any]:
+        result = run_agent(runtime, _spec(remote, cache, [{"agent": "agent-a", **op}]))
+        item: dict[str, Any] = result["results"][0]
+        assert item["success"], result
+        return item
+
+    def renewed_by(task_id: str) -> str:
+        message = subprocess.run(
+            [
+                "git",
+                "--git-dir",
+                str(remote),
+                "show",
+                "-s",
+                "--format=%B",
+                HEARTBEAT_PREFIX + heartbeat_key(task_id),
+            ],
+            check=True,
+            capture_output=True,
+            text=True,
+        ).stdout
+        runtime: str = json.loads(message)["runtime"]
+        return runtime
+
+    for task_id, first, second in (
+        ("claimed-by-nc5", nc5_runtime, SRC),
+        ("claimed-by-this", SRC, nc5_runtime),
+    ):
+        token = step(first, {"op": "claim", "task_id": task_id, "timeout": 60})["token"]
+        held = {"task_id": task_id, "token": token}
+        step(second, {"op": "renew", **held})
+        assert renewed_by(task_id) == (NC5 if second == nc5_runtime else cascade.__version__)
+        step(first, {"op": "renew", **held})
+        assert renewed_by(task_id) == (NC5 if first == nc5_runtime else cascade.__version__)
+        step(second, {"op": "complete", **held})
+
+    expected = {"claimed-by-nc5": "COMPLETED", "claimed-by-this": "COMPLETED"}
+    assert _audit(nc5_runtime, remote, cache) == expected
+    assert _audit(SRC, remote, cache) == expected
+    assert _heartbeat_refs(remote) == []
+    assert _runtime_markers(remote) >= {NC5, cascade.__version__}
+
+
+def test_this_runtime_passes_the_center_guard(
+    nc3_runtime: Path, center_guard: Path, tmp_path: Path
+) -> None:
+    remote = make_remote(tmp_path / "remote.git")
+    _seed(remote, tmp_path / "seed", "first", "second")
+    checkpoints = _install_guard(
+        remote, center_guard, nc3_runtime, tmp_path, ["agent-a", "agent-b"]
+    )
+    cache = tmp_path / "agent-a"
+
+    published = run_agent(
+        SRC,
+        _spec(
+            remote,
+            tmp_path / "publisher",
+            [{"op": "add", "id": "third"}],
+            writer="portal-publisher",
+        ),
+    )
+    assert published["results"][0]["success"], published
+    claim = run_agent(
+        SRC,
+        _spec(
+            remote,
+            cache,
+            [
+                {
+                    "op": "claim",
+                    "agent": "agent-a",
+                    "task_id": "first",
+                    "agent_tier": TIER,
+                    "timeout": 60,
+                }
+            ],
+            writer="agent-a",
+        ),
+    )["results"][0]
+    assert claim["success"], claim
+    for _ in range(2):
+        # A new process each time: no fetch, one heartbeat push the guard checks.
+        renewal = run_agent(
+            SRC,
+            _spec(
+                remote,
+                cache,
+                [{"op": "renew", "agent": "agent-a", "task_id": "first", "token": claim["token"]}],
+                writer="agent-a",
+            ),
+        )["results"][0]
+        assert renewal["success"], renewal
+    done = run_agent(
+        SRC,
+        _spec(
+            remote,
+            cache,
+            [{"op": "complete", "agent": "agent-a", "task_id": "first", "token": claim["token"]}],
+            writer="agent-a",
+        ),
+    )["results"][0]
+    assert done["success"], done
+
