+# Copyright 2026 Hangzhou Autoseek Information Technology Co., Ltd.
+# SPDX-License-Identifier: Apache-2.0
+"""Persist node messages at worker safe points without blocking lease renewal."""
+
+from __future__ import annotations
+
+import hashlib
+import json
+import os
+import re
+import stat
+import subprocess
+import sys
+import threading
+import time
+import urllib.error
+import urllib.request
+from pathlib import Path
+from typing import Any, NoReturn
+from urllib.parse import urlsplit
+
+from cascade.worker.config import WorkerConfig
+
+
+class _NoRedirect(urllib.request.HTTPRedirectHandler):
+    def redirect_request(self, *args: Any, **kwargs: Any) -> NoReturn:
+        raise ValueError("Node messaging redirects are forbidden")
+
+
+class NodeMessages:
+    def __init__(self, filename: Path, config: WorkerConfig, run_dir: Path):
+        settings = json.loads(filename.read_text())
+        origin = urlsplit(settings["origin"])
+        if (
+            origin.scheme != "https"
+            or origin.username
+            or origin.password
+            or origin.path
+            or origin.query
+            or origin.fragment
+        ):
+            raise ValueError("Node messaging requires an exact HTTPS origin")
+        center = settings["centerId"]
+        if not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9._-]{0,127}", center):
+            raise ValueError("Invalid node messaging center")
+        self.token = Path(settings["tokenFile"]).read_text().strip()
+        if not re.fullmatch(r"[a-f0-9]{64}", self.token):
+            raise ValueError("Node messaging requires a registered agent credential")
+        self.url = settings["origin"] + "/api/agent/collaboration/" + center + "/"
+        self.config = config
+        self.path = run_dir / "node-messages.json"
+        self.ack_path = run_dir / "node-message-ack.json"
+        self.messages: dict[str, dict[str, Any]] = {}
+        self.pending: set[str] = set()
+        self.unpulled: set[str] = set()
+        self.cursor = 0
+        self.stop_event = threading.Event()
+        self.thread = threading.Thread(target=self._run, name="cascade-node-messages", daemon=True)
+        self.lock = threading.Lock()
+        self.error = ""
+        self.deadline = time.monotonic() + 10
+        meta = self.api("meta")
+        own = next((a for a in meta["agents"] if a["id"] == meta["currentAgent"]), None)
+        if own != {"id": config.agent_id, "tier": config.agent_tier}:
+            raise ValueError("Worker identity/tier differs from registered messaging identity")
+        if (
+            meta["namespace"] != config.namespace
+            or meta["remoteSha256"]
+            != hashlib.sha256(
+                json.dumps(config.git_remote, ensure_ascii=False, separators=(",", ":")).encode()
+            ).hexdigest()
+        ):
+            raise ValueError("Worker messaging and execution centers differ")
+
+    def api(self, route: str, body: dict[str, Any] | None = None) -> dict[str, Any]:
+        remaining = self.deadline - time.monotonic()
+        if remaining <= 0:
+            raise TimeoutError("Node message safe point exceeded 10 seconds")
+        # A separate bounded process makes a slow streaming response cancellable.
+        # Credentials travel on stdin, never in process arguments or harness env.
+        result = subprocess.run(
+            [
+                sys.executable,
+                "-c",
+                "from cascade.worker.collaboration import http_request; http_request()",
+            ],
+            input=json.dumps({"url": self.url + route, "token": self.token, "body": body}),
+            capture_output=True,
+            text=True,
+            timeout=remaining,
+        )
+        if result.returncode != 0:
+            raise RuntimeError("Node messaging request failed: " + result.stderr.strip()[:100])
+        value: dict[str, Any] = json.loads(result.stdout)
+        return value
+
+    def poll(self) -> None:
+        with self.lock:
+            self.deadline = time.monotonic() + 10
+            while True:
+                page = self.api(f"tasks/{self.config.task_id}?after={self.cursor}")
+                for message in page["messages"]:
+                    self.messages[message["id"]] = message
+                    receipt = next(
+                        (r for r in message["receipts"] if r["agentId"] == self.config.agent_id),
+                        None,
+                    )
+                    if receipt is not None and not receipt["readAt"]:
+                        self.pending.add(message["id"])
+                        if not receipt["pulledAt"]:
+                            self.unpulled.add(message["id"])
+                self.cursor = page["nextCursor"]
