diff --git a/tests/integration/test_reservation_expiry.py b/tests/integration/test_reservation_expiry.py
new file mode 100644
index 0000000..6c0c7f7
--- /dev/null
+++ b/tests/integration/test_reservation_expiry.py
@@ -0,0 +1,189 @@
+"""Perspective: workers sharing a queue with absent reservation owners.
+Invariant: idle reservations expire at 1800 seconds; valid ACTIVE work, tiers,
+dependencies and fencing remain protected and recovery preserves the result.
+Goal: prevent indefinite reservations and duplicate execution on takeover.
+Migration: keep these public-client tests across real file and Git adapters.
+"""
+
+import time
+from concurrent.futures import ThreadPoolExecutor
+from dataclasses import replace
+from pathlib import Path
+
+import pytest
+from integration.test_task_retry import Store
+
+from cascade import CascadeClient
+from cascade.errors import StorageCorruptionError
+from cascade.replay import replay, verify
+from cascade.types import Contract
+
+
+@pytest.fixture(params=["file", "git"])
+def queue(tmp_path: Path, request: pytest.FixtureRequest) -> Store:
+    return Store(tmp_path, request.param)
+
+
+@pytest.fixture
+def clock(monkeypatch: pytest.MonkeyPatch) -> list[float]:
+    # Move only the wall clock. Real storage locks and Git processes still run.
+    now = [time.time()]
+    monkeypatch.setattr(time, "time", lambda: now[0])
+    return now
+
+
+@pytest.mark.parametrize("targeted", [True, False])
+def test_reservation_boundary_and_replay(queue: Store, clock: list[float], targeted: bool) -> None:
+    owner = queue.client()
+    assert owner.add("work", reserved_for="absent", required_tier="pro").success
+    assert owner.edit("work", summary="preserve context", critical={"scope": "x"}).success
+    worker = queue.client()
+    clock[0] += 1799
+    args = ("replacement", "work") if targeted else ("replacement",)
+    assert not worker.claim(*args, agent_tier="pro", timeout=1800).success
+    assert owner.load().nodes["work"].reserved_for == "absent"
+    clock[0] += 1
+    result = worker.claim(*args, agent_tier="pro", timeout=1800)
+    assert result.success, result.message
+    node = owner.load().nodes["work"]
+    assert node.agent_id == "replacement" and node.reserved_for is None
+    assert node.context and node.context.summary == "preserve context"
+    assert node.context.critical == {"scope": "x"}
+    assert node.required_tier == "pro"
+    events = owner.storage.events.read_all()
+    expiry = [e for e in events if e.data.get("reservation_expired")]
+    assert len(expiry) == 1
+    assert expiry[0].data["reservation_expired"]["reserved_for"] == "absent"
+    assert verify(events, owner.load(), owner.storage.content) == []
+    assert not owner.claim("absent", "work", agent_tier="max").success
+
+
+def test_active_renewal_then_timeout_releases_reservation(queue: Store, clock: list[float]) -> None:
+    owner = queue.client()
+    assert owner.add("work", reserved_for="owner").success
+    first = owner.claim("owner", "work", timeout=1800)
+    assert first.success
+    clock[0] += 1700
+    assert owner.renew("work", agent_id="owner", token=first.data["token"], timeout=1800).success
+    clock[0] += 1799
+    replacement = queue.client()
+    assert not replacement.claim("replacement", "work", timeout=1800).success
+    assert owner.load().nodes["work"].reserved_for == "owner"
+    clock[0] += 1
+    second = replacement.claim("replacement", "work", timeout=1800)
+    assert second.success, second.message
+    assert second.data["token"] > first.data["token"]
+    assert not owner.renew("work", agent_id="owner", token=first.data["token"]).success
+    assert not owner.complete("work", agent_id="owner", token=first.data["token"]).success
+    assert verify(owner.storage.events.read_all(), owner.load(), owner.storage.content) == []
+
+
+def test_sweeper_preserves_dependencies_and_tiers(queue: Store, clock: list[float]) -> None:
+    client = queue.client()
+    assert client.add("upstream").success
+    assert client.add(
+        "waiting", reserved_for="absent", deps={"upstream": Contract("e", "p")}
+    ).success
+    assert client.add("ready", reserved_for="absent", required_tier="max").success
+    clock[0] += 1800
+    result = client.check_timeouts()
+    assert result.success, result.message
+    assert result.data["expired_reservations"] == ["ready"]
+    graph = queue.client().load()
+    assert graph.nodes["waiting"].reserved_for == "absent"
+    assert graph.nodes["waiting"].state.name == "PENDING"
+    assert graph.nodes["ready"].reserved_for is None
+    assert not client.claim("low", "ready", agent_tier="pro").success
+    assert not client.claim("low", "waiting", agent_tier="max").success
+    assert client.claim("high", "ready", agent_tier="max").success
+    assert client.check_timeouts().data["expired_reservations"] == []
+    assert verify(client.storage.events.read_all(), client.load(), client.storage.content) == []
+
+
+def test_release_restarts_idle_window(queue: Store, clock: list[float]) -> None:
+    client = queue.client()
+    assert client.add("work", reserved_for="owner").success
+    first = client.claim("owner", "work", timeout=7200)
+    clock[0] += 3600
+    assert client.release(
+        "work", agent_id="owner", token=first.data["token"], reason="pause"
+    ).success
+    assert not client.claim("other", "work").success
+    clock[0] += 1800
+    assert queue.client().claim("other", "work").success
+
+
+def test_concurrent_takeover_has_one_winner(queue: Store, clock: list[float]) -> None:
+    owner = queue.client()
+    assert owner.add("work", reserved_for="absent").success
+    clock[0] += 1800
+    workers = [(queue.client(), "a"), (queue.client(), "b")]
+    with ThreadPoolExecutor(max_workers=2) as pool:
+        results = list(pool.map(lambda pair: pair[0].claim(pair[1], "work", timeout=1800), workers))
+    assert sum(result.success for result in results) == 1
+    owner.load()
+    assert (
+        len([e for e in owner.storage.events.read_all() if e.data.get("reservation_expired")]) == 1
+    )
+    assert verify(owner.storage.events.read_all(), owner.load(), owner.storage.content) == []
+
+
+def test_replay_rejects_false_expiry_evidence(queue: Store, clock: list[float]) -> None:
+    client = queue.client()
+    assert client.add("work", reserved_for="owner").success
+    clock[0] += 1800
+    assert client.check_timeouts().success
+    events = client.storage.events.read_all()
+    index = next(i for i, e in enumerate(events) if e.data.get("reservation_expired"))
+    event = events[index]
+    for altered in [
+        replace(event, timestamp=event.timestamp - 1),
+        replace(event, data={**event.data, "reservation_expired": {}}),
+    ]:
+        with pytest.raises(StorageCorruptionError):
+            replay(events[:index] + [altered] + events[index + 1 :])
+
+
+def test_missing_history_does_not_guess_age(tmp_path: Path, clock: list[float]) -> None:
+    from cascade.core.cascade import Cascade
+    from cascade.core.node import Node
+    from cascade.core.state import NodeState
+
+    client = CascadeClient(tmp_path)
+    graph = Cascade()
+    graph.add_node(Node(id="unknown", state=NodeState.READY, reserved_for="owner"))
+    client.storage.save(graph)
+    result = client.check_timeouts()
+    assert not result.success and "Cannot determine reservation age" in result.message
+    assert client.load().nodes["unknown"].reserved_for == "owner"
+    assert not client.storage.events.read_all()
+
+
+def test_split_children_get_their_own_idle_window(queue: Store, clock: list[float]) -> None:
+    client = queue.client()
+    assert client.add("parent", reserved_for="owner").success
+    clock[0] += 2000
+    assert client.split("parent", ["a", "b"]).success
+    assert not client.claim("other").success
+    clock[0] += 1800
+    assert client.check_timeouts().data["expired_reservations"] == ["a", "b"]
+    assert verify(client.storage.events.read_all(), client.load(), client.storage.content) == []
+
+
+def test_rejected_publication_preserves_reservation(tmp_path: Path, clock: list[float]) -> None:
+    store = Store(tmp_path, "git")
+    client = store.client()
+    assert client.add("work", reserved_for="owner").success
+    clock[0] += 1800
+    hook = store.remote / "hooks" / "update"
+    hook.write_text('#!/bin/sh\ncase "$1" in refs/heads/cascade-state/*) exit 1;; esac\nexit 0\n')
+    hook.chmod(0o755)
+    before = store.durable()
+    result = store.client().claim("replacement", "work", timeout=1800)
+    assert not result.success
+    assert store.durable() == before
+    hook.unlink()
+    fresh = store.client()
+    assert fresh.load().nodes["work"].reserved_for == "owner"
+    assert not any(e.data.get("reservation_expired") for e in fresh.storage.events.read_all())
+    assert fresh.claim("replacement", "work", timeout=1800).success
diff --git a/tests/test_task_input_publication.py b/tests/test_task_input_publication.py
new file mode 100644
index 0000000..494caa8
--- /dev/null
+++ b/tests/test_task_input_publication.py
@@ -0,0 +1,210 @@
+"""Perspective: a qualified agent taking over a task without the author's chat.
+
+Invariant: publication inputs survive storage/replay and exactly 300 seconds of
+publisher preference never overrides prerequisites, tiers or a valid lease.
+Goal: prevent early takeover, permanent reservation and silent context loss.
+Migration: keep these real storage checks with native claim and serialization.
+"""
+
+import hashlib
+import json
+import subprocess
+import sys
+from unittest.mock import patch
+
+import pytest
+
+from cascade import CascadeClient
+from cascade.replay import verify
+from cascade.storage.file_storage import FileStorage
+from cascade.types import Contract, TaskView
+from cascade.view import render_briefing
+
+
+def test_only_one_process_can_claim_after_protection(tmp_path):
+    client, storage, _ = fixture(tmp_path)
+    command = "import json,sys;from cascade import CascadeClient;c=CascadeClient(sys.argv[1]);print(json.dumps(c.claim(sys.argv[2],task_id='task',agent_tier='pro').to_dict()))"
+    workers = [
+        subprocess.Popen(
+            [sys.executable, "-c", command, str(tmp_path), agent],
+            stdout=subprocess.PIPE,
+            stderr=subprocess.PIPE,
+            text=True,
+        )
+        for agent in ["peer-a", "peer-b"]
+    ]
+    results = []
+    for worker in workers:
+        out, err = worker.communicate(timeout=20)
+        assert worker.returncode == 0, err
+        results.append(json.loads(out))
+    assert sum(result["success"] for result in results) == 1
+    assert client.load().nodes["task"].agent_id in {"peer-a", "peer-b"}
+    assert storage.events.verify_chain()[0]
+    assert verify(storage.events.read_all(), client.load(), storage.content) == []
+
+
+@pytest.mark.parametrize("operation", ["remove", "split", "refine", "inject"])
+def test_published_input_cannot_be_deleted_or_rewired(tmp_path, operation):
+    client, storage, _ = fixture(tmp_path)
+    assert client.add("other").success
+    before = [event.to_dict() for event in storage.events.read_all()]
+    if operation == "remove":
+        result = client.remove("task")
+    elif operation == "split":
+        result = client.split("task", ["first", "second"])
+    elif operation == "refine":
+        result = client.refine("task", "other", "changed", "changed")
+    else:
+        result = client.add("injected", dependents={"task": Contract("changed", "changed")})
+    assert not result.success
+    assert "immutable" in result.message
+    assert [event.to_dict() for event in storage.events.read_all()] == before
+    assert set(client.load().nodes) == {"task", "other"}
+    assert client.load().nodes["task"].task_input is not None
+
+
+@pytest.mark.parametrize("operation", ["renew", "complete"])
+def test_expired_owner_cannot_revive_or_complete_before_reclaimer_runs(tmp_path, operation):
+    client, storage, _ = fixture(tmp_path)
+    with patch("time.time", return_value=1001):
+        claim = client.claim("author", task_id="task", agent_tier="pro", timeout=10)
+    with patch("time.time", return_value=1012):
+        result = getattr(client, operation)("task", agent_id="author", token=claim.data["token"])
+    assert not result.success
+    assert client.load().nodes["task"].state.name == "READY"
+    assert client.load().nodes["task"].claim_token is None
+    assert verify(storage.events.read_all(), client.load(), storage.content) == []
+
+
+def task_input(dependencies=None):
+    brief = {
+        "title": "接手任务",
+        "goal": "Implement within the approved scope",
+        "context": "Use the documented API; no original chat is required",
+        "acceptance": "Verify real boundary behavior",
+        "baseline": "a" * 40,
+        "requiredTier": "pro",
+        "dependencies": dependencies or [],
+        "group": None,
+    }
+    checksum = hashlib.sha256(
+        json.dumps(brief, sort_keys=True, ensure_ascii=False, separators=(",", ":")).encode()
+    ).hexdigest()
+    return {
+        "schema_version": 1,
+        "publication_id": "fixture-publication",
+        "brief_sha256": checksum,
+        "brief": brief,
+    }
+
+
+def fixture(tmp_path, dependencies=None):
+    storage = FileStorage(tmp_path)
+    client = CascadeClient(storage)
+    for dep in dependencies or []:
+        assert client.add(dep).success
+    envelope = task_input(dependencies)
+    with patch("time.time", return_value=1000.0):
+        result = client.add(
+            "task",
+            required_tier="pro",
+            task_input=envelope,
+            publisher="author",
+            deps={
+                d: Contract("Provide approved input", "Deliver verified result")
+                for d in dependencies or []
+            },
+        )
+    assert result.success, result.message
+    return client, storage, envelope
+
+
+@pytest.mark.parametrize("specific", [True, False])
+def test_other_agent_claims_at_exact_boundary(tmp_path, specific):
+    client, storage, envelope = fixture(tmp_path)
+    with patch("time.time", return_value=1299.999):
+        result = client.claim("peer", task_id="task" if specific else None, agent_tier="pro")
+        assert not result.success
+    with patch("time.time", return_value=1300.0):
+        result = client.claim("peer", task_id="task" if specific else None, agent_tier="pro")
+    assert result.success, result.message
+    assert result.data["task_info"]["task_input"] == envelope
+    assert TaskView.from_result(result).task_input == envelope
+    assert "original chat is required" in render_briefing(result.data["task_info"])
+    node = storage.load().nodes["task"]
+    assert node.timeout == 900.0
+    assert node.publication == {
+        "publisher": "author",
+        "published_at": 1000.0,
+        "protected_until": 1300.0,
+    }
+    assert verify(storage.events.read_all(), storage.load(), storage.content) == []
+
+
+def test_publisher_claims_immediately_and_active_lease_is_not_stolen(tmp_path):
+    client, storage, envelope = fixture(tmp_path)
+    with patch("time.time", return_value=1001.0):
+        claimed = client.claim("author", task_id="task", agent_tier="pro", timeout=600)
+    assert claimed.success
+    with patch("time.time", return_value=1301.0):
+        assert not client.claim("peer", task_id="task", agent_tier="max").success
+    assert storage.load().nodes["task"].agent_id == "author"
+    with patch("time.time", return_value=1601.0):
+        recovered = client.claim("peer", task_id="task", agent_tier="pro", timeout=600)
+    assert recovered.success
+    stale = client.complete("task", agent_id="author", token=claimed.data["token"], summary="stale")
+    assert not stale.success
+    assert recovered.data["token"] != claimed.data["token"]
+    assert recovered.data["task_info"]["task_input"] == envelope
+
+
+def test_preference_does_not_bypass_dependencies_or_tier(tmp_path):
+    client, storage, _ = fixture(tmp_path, ["upstream"])
+    with patch("time.time", return_value=1301.0):
+        assert not client.claim("peer", task_id="task", agent_tier="max").success
+        upstream = client.claim("upstream-worker", task_id="upstream", timeout=600)
+        assert upstream.success
+        assert client.complete(
+            "upstream",
+            agent_id="upstream-worker",
+            token=upstream.data["token"],
+            summary="Delivered upstream context",
+            deliverables={"task": "Verified upstream result"},
+        ).success
+        assert not client.claim("author", task_id="task", agent_tier="lite").success
+        claimed = client.claim("peer", task_id="task", agent_tier="pro")
+    assert claimed.success
+    assert (
+        claimed.data["task_info"]["upstream"][0]["delivered"]["summary"]
+        == "Delivered upstream context"
+    )
+    assert storage.load().nodes["task"].publication["protected_until"] == 1300.0
+
+
+def test_input_is_detached_from_publishers_mutable_object(tmp_path):
+    _, storage, envelope = fixture(tmp_path)
+    envelope["brief"]["context"] = "Changed after publication"
+    loaded = storage.load()
+    assert (
+        loaded.nodes["task"].task_input["brief"]["context"]
+        == "Use the documented API; no original chat is required"
+    )
+    assert verify(storage.events.read_all(), loaded, storage.content) == []
+
+
+def test_batch_rejects_bad_checksum_without_partial_publication(tmp_path):
+    storage = FileStorage(tmp_path)
+    client = CascadeClient(storage)
+    assert client.add("existing").success
+    value = task_input()
+    value["brief_sha256"] = "0" * 64
+    result = client.add_batch(
+        [
+            {"node_id": "first"},
+            {"node_id": "bad", "required_tier": "pro", "publisher": "author", "task_input": value},
+        ]
+    )
+    assert not result.success
+    assert set(storage.load().nodes) == {"existing"}
+    assert [e.data["node_id"] for e in storage.events.read_all()] == ["existing"]
