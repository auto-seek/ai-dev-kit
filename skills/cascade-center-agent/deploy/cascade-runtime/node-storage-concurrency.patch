+    client = CascadeClient(storage)
+    graph_file = storage.cache_dir / "git-state" / "data" / "graph.json"
+    graph_file.write_text('{"nodes": {}, "edges": [], "epoch": 0}', encoding="utf-8")
+    (graph_file.parent / "stray.json").write_text("{}", encoding="utf-8")
+
