+def test_redone_claim_and_completion_are_correct_and_idempotent(
+    remote: Path, tmp_path: Path, monkeypatch: pytest.MonkeyPatch
+) -> None:
+    publisher = _client(remote, tmp_path / "publisher")
+    assert publisher.add("first").success
+    assert publisher.add("second").success
+    storage = _storage(remote, tmp_path / "worker")
+    worker = CascadeClient(storage)
+    rival = _client(remote, tmp_path / "rival")
+    real_commit = storage._commit_state
+    race = {"claim": True}
+
+    def rival_wins_once() -> str | None:
+        if race.pop("claim", False):
+            assert rival.claim("rival", "first", timeout=60).success
+        return real_commit()
+
+    monkeypatch.setattr(storage, "_commit_state", rival_wins_once)
+    claim = worker.claim("agent-a", timeout=60)
+    assert claim.success and claim.data["task_id"] == "second"
+    rival_token = _payload(remote, "first")["claim_token"]
+    assert claim.data["token"] > rival_token
+
+    race["claim"] = True
+
+    def rival_writes_once() -> str | None:
+        if race.pop("claim", False):
+            assert rival.add("unrelated").success
+        return real_commit()
+
+    monkeypatch.setattr(storage, "_commit_state", rival_writes_once)
+    done = worker.complete(
+        "second", agent_id="agent-a", token=claim.data["token"], op_id="complete-second"
+    )
+    again = worker.complete(
+        "second", agent_id="agent-a", token=claim.data["token"], op_id="complete-second"
+    )
+
+    assert done.success and again.success
+    assert again.data == done.data
+    history = _client(remote, tmp_path / "auditor").history(node_id="second").data["events"]
+    assert [event["type"] for event in history].count("task_completed") == 1
+    assert _heartbeat_ref("second") not in remote_refs(remote)
+
