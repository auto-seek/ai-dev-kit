+"""Read snapshots and optimistic atomic publication against real bare Git remotes.
+
+Perspective: a busy center whose verifiers read constantly while agents write.
+Invariant: read snapshots never change remote refs and always come from one
+state commit; a write publishes with one atomic expected-OID push, a lost
+compare-and-swap publishes nothing and is redone on the latest state, and
+every failure leaves either the old state or the complete new state.
+Goal: cut remote round trips and remove the global write lock without losing
+updates, serving a stale cache, or reporting a half-published transaction.
+Migration: integration evidence since 0.8.2+nodecollab.2 (reads) and .3
+(lock-free writes); heartbeats, mixed runtimes and remote-call comparisons
+live in their own Git storage test modules.
+"""
+
+from __future__ import annotations
+
+import json
+import os
+import subprocess
+import time
+from pathlib import Path
+from typing import Any
+
+import pytest
+from git_remote_kit import (
+    SRC,
+    commit_count,
+    finish_agent,
+    git_blob,
+    install_git_counter,
+    make_remote,
+    remote_calls,
+    remote_refs,
+    run_agent,
+    start_agent,
+)
+
+from cascade.client import CascadeClient
+from cascade.core.cascade import Cascade
+from cascade.core.node import Node
+from cascade.core.state import NodeState
+from cascade.errors import LockError, StateConflictError, StorageCorruptionError
+from cascade.events import Event
+from cascade.replay import verify
+from cascade.storage.git_storage import GitStorage
+from cascade.types import TaskView
+from cascade.verification import verify_log, verify_storage
+
+NAMESPACE = "snap"
+STATE_REF = f"refs/heads/cascade-state/{NAMESPACE}"
+LOCK_REF = f"refs/heads/cascade-lock/{NAMESPACE}"
+
+
+def _storage(remote: Path, cache: Path, **options: Any) -> GitStorage:
+    return GitStorage(str(remote), namespace=NAMESPACE, cache_dir=cache, **options)
+
+
+def _client(remote: Path, cache: Path) -> CascadeClient:
+    return CascadeClient(_storage(remote, cache))
+
+
+def _spec(remote: Path, cache: Path, ops: list[dict[str, Any]]) -> dict[str, Any]:
+    return {"remote": str(remote), "namespace": NAMESPACE, "cache": str(cache), "ops": ops}
+
+
+def _ids(client: CascadeClient) -> list[str]:
+    listed = client.nodes()
+    assert listed.success, listed.message
+    return sorted(node["id"] for node in listed.data["nodes"])
+
+
+def _rogue_commit(remote: Path, parent: str, message: str) -> str:
+    """A complete commit made directly in the remote, bypassing every lease."""
+    return subprocess.run(
+        ["git", "--git-dir", str(remote), "commit-tree", f"{parent}^{{tree}}", "-p", parent],
+        input=message,
+        check=True,
+        capture_output=True,
+        text=True,
+    ).stdout.strip()
+
+
+def _set_ref(remote: Path, ref: str, oid: str) -> None:
+    subprocess.run(["git", "--git-dir", str(remote), "update-ref", ref, oid], check=True)
+
+
+def _install_hook(remote: Path, name: str, body: str) -> None:
+    hook = remote / "hooks" / name
+    hook.write_text("#!/bin/sh\n" + body, encoding="utf-8")
+    hook.chmod(0o755)
+
+
+@pytest.fixture
+def remote(tmp_path: Path) -> Path:
+    return make_remote(tmp_path / "remote.git")
+
+
+@pytest.fixture
+def seeded(remote: Path, tmp_path: Path) -> CascadeClient:
+    """A namespace with nodes, an active claim, and history to read."""
+    writer = _client(remote, tmp_path / "seed-cache")
+    assert writer.add("alpha").success
+    assert writer.add("beta").success
+    assert writer.claim("worker", "beta").success
+    return writer
+
+
+def test_read_snapshot_and_queries_never_push_or_change_refs(
+    remote: Path, seeded: CascadeClient, tmp_path: Path, monkeypatch: pytest.MonkeyPatch
+) -> None:
+    before = remote_refs(remote)
+    commits = commit_count(remote, STATE_REF)
+    pushes = tmp_path / "push-attempts.log"
+    # Any push attempt, accepted or not, would be recorded and refused.
+    _install_hook(remote, "pre-receive", f'cat >> "{pushes}"\nexit 1\n')
+    log = tmp_path / "git.log"
+    monkeypatch.setenv("PATH", f"{install_git_counter(tmp_path / 'bin')}:{os.environ['PATH']}")
+    monkeypatch.setenv("CASCADE_GIT_LOG", str(log))
+
+    storage = _storage(remote, tmp_path / "observer")
+    client = CascadeClient(storage)
+    first_ts = client.history().data["events"][0]["logical_ts"]
+    assert client.nodes().success
+    assert client.check("beta").data["valid"] is True
+    assert client.history(node_id="beta").success
+    assert client.show(first_ts).success
+    assert client.diff(first_ts, first_ts + 10**12).success
+    assert client.snapshot_at(first_ts).success
+    assert set(client.load().nodes) == {"alpha", "beta"}
+    with storage.read_snapshot():
+        graph = storage.load()
+        assert graph is not None
+        assert storage.events.verify_chain()[0]
+        assert verify(storage.events.read_all(), graph, storage.content) == []
+        token = storage.tokens.check("beta")
+        assert token is not None and token.valid
+
+    assert remote_refs(remote) == before
+    assert LOCK_REF not in before
+    assert commit_count(remote, STATE_REF) == commits
+    assert not pushes.exists()
+    assert remote_calls(log)["push"] == 0
+
+
+def test_reads_and_writes_proceed_while_another_process_is_mid_transaction(
+    remote: Path, seeded: CascadeClient, tmp_path: Path
+) -> None:
+    marker = tmp_path / "held"
+    holder = start_agent(
+        SRC,
+        _spec(remote, tmp_path / "holder", [{"op": "hold", "marker": str(marker), "seconds": 8}]),
+    )
+    try:
+        deadline = time.monotonic() + 30
+        while not marker.exists():
+            assert time.monotonic() < deadline, "holder never entered its transaction"
+            time.sleep(0.02)
+        client = _client(remote, tmp_path / "reader")
+
+        started = time.monotonic()
+        assert _ids(client) == ["alpha", "beta"]
+        assert client.history().data["count"] == 3
+        assert client.check("beta").data["valid"] is True
+        assert client.add("gamma").success
+        elapsed = time.monotonic() - started
+
+        assert elapsed < 4, f"another transaction blocked this one: {elapsed:.2f}s"
+        assert holder.poll() is None, "holder finished before the others"
+        assert LOCK_REF not in remote_refs(remote)
+    finally:
+        finish_agent(holder)
+
+
+def test_snapshots_come_from_one_state_oid_while_writers_advance(
+    remote: Path, seeded: CascadeClient, tmp_path: Path
+) -> None:
+    writers = [
+        start_agent(
+            SRC,
+            _spec(
+                remote,
+                tmp_path / f"writer-{index}",
+                [{"op": "add", "id": f"w{index}-{step}"} for step in range(10)],
+            ),
+        )
+        for index in range(2)
+    ]
+    storage = _storage(remote, tmp_path / "reader")
+    seen: dict[str, tuple[list[str], list[str]]] = {}
+    try:
+        while True:
+            writers_done = all(writer.poll() is not None for writer in writers)
+            with storage.read_snapshot():
+                oid = storage.state_oid
+                assert oid is not None
+                graph = storage.load()
+                assert graph is not None
+                events = storage.events.read_all()
+                assert storage.events.verify_chain()[0]
+                assert verify(events, graph, storage.content) == []
+            seen[oid] = (sorted(graph.nodes), [event.id for event in events])
+            if writers_done:
+                break
+    finally:
+        results = [finish_agent(writer) for writer in writers]
+
+    assert all(item["success"] for result in results for item in result["results"])
+    assert len(seen) >= 2, "the reader never observed the writers advancing"
+    for oid, (node_ids, event_ids) in seen.items():
+        committed_graph = json.loads(git_blob(remote, oid, "data/graph.json"))
+        committed_events = [
+            Event.from_dict(json.loads(line)).id
+            for line in git_blob(remote, oid, "data/events.jsonl").splitlines()
+            if line.strip()
+        ]
+        assert node_ids == sorted(committed_graph["nodes"])
+        assert event_ids == committed_events
+
