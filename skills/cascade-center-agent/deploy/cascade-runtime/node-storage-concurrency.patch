+@pytest.mark.parametrize("renew", [True, False])
+def test_published_task_completion_uses_the_heartbeat_lease(
+    remote: Path, tmp_path: Path, renew: bool
+) -> None:
+    publisher = _client(remote, tmp_path / "publisher")
+    assert publisher.add(
