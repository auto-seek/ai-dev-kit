+"""Which client calls use the read-only snapshot and which take the write lock.
+
+Perspective: a backend whose write lock is expensive (a remote Git lease).
+Invariant: pure queries enter ``read_snapshot`` only; anything that may write,
+including ``check_timeouts``, still takes ``lock``.
+Goal: keep read traffic off the write lock without weakening mutations.
+Migration: unit contract; the Git backend's remote behavior is covered by the
+Git storage integration tests.
+"""
+
+from __future__ import annotations
+
+from collections.abc import Callable, Generator
+from contextlib import contextmanager
+from pathlib import Path
+
+import pytest
+
+from cascade.client import CascadeClient
+from cascade.storage.file_storage import FileStorage
+
+
+class _CountingStorage(FileStorage):
+    def __init__(self, path: Path) -> None:
+        super().__init__(path)
+        self.entries: list[str] = []
+
+    @contextmanager
+    def lock(self, timeout: float = 10.0, blocking: bool = True) -> Generator[None, None, None]:
+        self.entries.append("lock")
+        with super().lock(timeout=timeout, blocking=blocking):
+            yield
+
+    @contextmanager
+    def read_snapshot(
+        self, timeout: float = 10.0, blocking: bool = True
+    ) -> Generator[None, None, None]:
+        self.entries.append("read_snapshot")
+        with FileStorage.lock(self, timeout=timeout, blocking=blocking):
+            yield
+
+
+@pytest.fixture
+def counted(tmp_path: Path) -> tuple[CascadeClient, _CountingStorage, int]:
+    storage = _CountingStorage(tmp_path / "state")
+    client = CascadeClient(storage)
+    assert client.add("a").success
+    assert client.claim("agent", "a").success
+    first_ts = client.history().data["events"][0]["logical_ts"]
+    storage.entries.clear()
+    return client, storage, first_ts
+
+
+READS: dict[str, Callable[[CascadeClient, int], object]] = {
+    "nodes": lambda client, ts: client.nodes(),
+    "check": lambda client, ts: client.check("a"),
+    "history": lambda client, ts: client.history(),
+    "show": lambda client, ts: client.show(ts),
+    "diff": lambda client, ts: client.diff(ts, ts),
+    "snapshot_at": lambda client, ts: client.snapshot_at(ts),
+    "load": lambda client, ts: client.load(),
+}
+
+
+@pytest.mark.parametrize("name", sorted(READS))
+def test_queries_use_only_the_read_snapshot(
+    counted: tuple[CascadeClient, _CountingStorage, int], name: str
+) -> None:
+    client, storage, first_ts = counted
+    READS[name](client, first_ts)
+    assert storage.entries == ["read_snapshot"]
+
+
+def test_check_timeouts_still_takes_the_write_lock(
+    counted: tuple[CascadeClient, _CountingStorage, int],
+) -> None:
+    client, storage, _ = counted
+    assert client.check_timeouts(default_timeout=0).data["count"] == 1
+    assert storage.entries == ["lock"]
