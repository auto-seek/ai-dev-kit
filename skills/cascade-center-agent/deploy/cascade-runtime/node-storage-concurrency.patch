+def test_every_expiry_check_counts_the_current_heartbeat(remote: Path, tmp_path: Path) -> None:
+    assert _client(remote, tmp_path / "publisher").add("task").success
+    worker = _client(remote, tmp_path / "worker")
+    token = worker.claim("agent-a", "task", timeout=6).data["token"]
+    time.sleep(3.0)
+    assert worker.renew("task", agent_id="agent-a", token=token).success
+    time.sleep(3.3)
+    other = _client(remote, tmp_path / "other")
+
+    # Past claimed_at + timeout, but within the heartbeat's lease.
+    assert other.check_timeouts().data["count"] == 0
+    refused = other.claim("agent-b")
+    assert refused.code == ErrorCode.NO_READY_TASKS
+    assert "stale" not in _states(other)["task"]
+    assert _heartbeat_ref("task") in remote_refs(remote)
+
+    time.sleep(3.2)
+    released = other.check_timeouts()
+    assert [item["task_id"] for item in released.data["released"]] == ["task"]
+    assert _heartbeat_ref("task") not in remote_refs(remote)
+    late = worker.complete("task", agent_id="agent-a", token=token)
+    assert late.code in (ErrorCode.TASK_NOT_ACTIVE, ErrorCode.STALE_TOKEN)
+
