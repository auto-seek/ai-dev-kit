+def test_a_heartbeat_of_an_older_claim_is_ignored_and_cleaned(remote: Path, tmp_path: Path) -> None:
+    assert _client(remote, tmp_path / "publisher").add("task").success
+    first = _client(remote, tmp_path / "first")
+    old_token = first.claim("agent-a", "task", timeout=60).data["token"]
+    assert first.release("task", agent_id="agent-a", token=old_token).success
+    second = _client(remote, tmp_path / "second")
+    new_token = second.claim("agent-b", "task", timeout=2).data["token"]
+    # A stale writer forges a far-future heartbeat for the released claim.
+    current = remote_refs(remote)[_heartbeat_ref("task")]
+    payload = {**_payload(remote, "task"), "agent_id": "agent-a", "claim_token": old_token}
+    payload["renewed_at"] = time.time() + 3600
+    forged = _git(
+        remote,
+        "commit-tree",
+        _git(remote, "hash-object", "-t", "tree", "-w", "--stdin", stdin=""),
+        "-p",
+        current,
+        stdin=json.dumps(payload),
+    )
+    _git(remote, "update-ref", _heartbeat_ref("task"), forged)
+    assert first.renew("task", agent_id="agent-a", token=old_token).code == ErrorCode.STALE_TOKEN
+    time.sleep(2.2)
+
+    released = _client(remote, tmp_path / "reaper").check_timeouts()
+
+    assert [item["task_id"] for item in released.data["released"]] == ["task"]
+    assert _heartbeat_ref("task") not in remote_refs(remote)
+    assert second.renew("task", agent_id="agent-b", token=new_token).code in (
+        ErrorCode.TASK_NOT_ACTIVE,
+        ErrorCode.STALE_TOKEN,
+    )
+
