+
+"""Incremental log verification gives exactly the full verification's verdict.
+
+Perspective: a receive hook or client that verified a state once and now
+sees the same log with events appended, rewritten, reordered or cut.
+Invariant: for the same bytes, snapshot and content, ``verify_appended``
+from a checkpoint reports the same validity, chain message, replay
+differences and contract check as ``verify_log`` over the whole log, and it
+only skips work when the verified prefix is byte-identical.
+Goal: let hooks and clients stop re-verifying the whole history per action
+without accepting anything a full check would reject.
+Migration: unit contract for the public cascade.verification API.
+"""
+
+from __future__ import annotations
+
+import copy
+import json
+from collections.abc import Callable
+from pathlib import Path
+from unittest.mock import patch
+
+import pytest
+from conftest import auto_deliverables
+
+from cascade.client import CascadeClient
+from cascade.core.cascade import Cascade
+from cascade.core.state import NodeState
+from cascade.events import EventType, FileEventStore
+from cascade.replay import verify
+from cascade.storage.content import ContentStore
+from cascade.storage.file_storage import FileStorage
+from cascade.types import Contract
+from cascade.verification import LogCheckpoint, verify_appended, verify_log
+
+
+class _Log:
+    def __init__(self, storage: FileStorage, cut: int) -> None:
+        self.storage = storage
+        self.raw = storage.events.read_bytes()
+        self.snapshot = storage.load() or Cascade()
+        self.cut = cut  # events in the checkpointed prefix
+
+    @property
+    def lines(self) -> list[bytes]:
+        return self.raw.split(b"\n")[:-1]
+
+
+@pytest.fixture
+def log(tmp_path: Path) -> tuple[LogCheckpoint, _Log]:
+    """A checkpoint after a failure, then a retry, a reservation expiry and more work."""
+    storage = FileStorage(tmp_path / "state")
+    client = CascadeClient(storage)
+    with patch("time.time", return_value=1000.0):
+        assert client.add("a").success
+        assert client.add("b", deps={"a": Contract("E", "P")}).success
+        assert client.add("c").success
+        assert client.add("reserved", reserved_for="owner").success
+        token = client.claim("w1", "a").data["token"]
+        assert client.complete(
+            "a",
+            agent_id="w1",
+            token=token,
+            summary="done",
+            artifacts="artifact text",
+            deliverables=auto_deliverables(client, "a"),
+        ).success
+        failing = client.claim("w2", "c").data["token"]
+        assert client.fail("c", agent_id="w2", token=failing, reason="broke").success
+    prefix = _Log(storage, len(storage.events.read_all()))
+    checked = verify_log(prefix.raw, prefix.snapshot, storage.content)
+    assert checked.valid and checked.checkpoint is not None
+
+    failure = [e for e in storage.events.read_all() if e.type == EventType.TASK_FAILED][-1]
+    with patch("time.time", return_value=1000.0 + 1801):
+        assert client.retry("c", failure_event_id=failure.id, reason="fixed", agent_id="op").success
+        # This claim expires the idle reservation; replay looks back into the prefix.
+        token = client.claim("w3").data["token"]
+        assert client.release(next(iter(_active(client))), agent_id="w3", token=token).success
+        assert client.add("d", deps={"b": Contract("E2", "P2")}).success
+    events = storage.events.read_all()
+    assert any(e.type == EventType.TASK_RETRIED for e in events[prefix.cut :])
+    assert any("reservation_expired" in e.data for e in events[prefix.cut :])
+    return checked.checkpoint, _Log(storage, prefix.cut)
+
+
+def _active(client: CascadeClient) -> list[str]:
+    return [n.id for n in client.load().nodes.values() if n.state == NodeState.ACTIVE]
+
+
+def _join(lines: list[bytes]) -> bytes:
+    return b"".join(line + b"\n" for line in lines)
+
+
+def _edit(line: bytes, change: Callable[[dict], None]) -> bytes:
+    data = json.loads(line)
+    change(data)
+    return json.dumps(data, ensure_ascii=False).encode("utf-8")
+
+
+def _swap(lines: list[bytes], i: int, j: int) -> list[bytes]:
+    out = list(lines)
+    out[i], out[j] = out[j], out[i]
+    return out
+
+
+def _variants(log: _Log) -> dict[str, tuple[bytes, bool]]:
+    """Log bytes and whether the checkpoint prefix survives byte for byte."""
+    lines, cut = log.lines, log.cut
+    tail = len(lines) - 1
+    retried = next(i for i, line in enumerate(lines) if b'"task_retried"' in line)
+    return {
+        "untouched": (log.raw, True),
+        "tampered tail event": (
+            _join(lines[:tail] + [_edit(lines[tail], lambda d: d["data"].update(x=1))]),
+            True,
+        ),
+        "tampered prefix event": (
+            _join([_edit(lines[0], lambda d: d["data"].update(x=1))] + lines[1:]),
+            False,
+        ),
+        "tampered retry evidence": (
+            _join(
+                lines[:retried]
+                + [_edit(lines[retried], lambda d: d["data"].update(failure_event_id="other"))]
+                + lines[retried + 1 :]
+            ),
+            True,
+        ),
+        "reordered tail": (_join(_swap(lines, cut, cut + 1)), True),
+        "reordered prefix": (_join(_swap(lines, 1, 2)), False),
+        "reordered across the checkpoint": (_join(_swap(lines, cut - 1, cut)), False),
+        "dropped tail event": (_join(lines[: cut + 1] + lines[cut + 2 :]), True),
+        "truncated tail": (_join(lines[:-2]), True),
+        "truncated to the checkpoint": (_join(lines[:cut]), True),
+        "truncated into the prefix": (_join(lines[: cut - 1]), False),
+        "cut mid-line": (log.raw[: len(log.raw) - 7], True),
+        "garbage appended": (log.raw + b"not json\n", True),
+        "not UTF-8 appended": (log.raw + b"\xff\xfe\n", True),
+        "blank lines appended": (log.raw + b"\n\n", True),
+    }
+
+
+@pytest.mark.parametrize(
+    "case",
+    [
+        "untouched",
+        "tampered tail event",
+        "tampered prefix event",
+        "tampered retry evidence",
+        "reordered tail",
+        "reordered prefix",
+        "reordered across the checkpoint",
+        "dropped tail event",
+        "truncated tail",
+        "truncated to the checkpoint",
+        "truncated into the prefix",
+        "cut mid-line",
+        "garbage appended",
+        "not UTF-8 appended",
+        "blank lines appended",
+    ],
+)
+def test_incremental_and_full_verification_agree(
+    log: tuple[LogCheckpoint, _Log], case: str
+) -> None:
+    checkpoint, current = log
+    raw, preserved = _variants(current)[case]
+    content = current.storage.content
+
+    full = verify_log(raw, current.snapshot, content)
+    incremental = verify_appended(checkpoint, raw, current.snapshot, content)
+
+    assert incremental.conclusion() == full.conclusion()
+    assert incremental.prefix_preserved is preserved
+    assert incremental.incremental is preserved
+    assert full.valid is (case in {"untouched", "blank lines appended"})
+
+
+def test_full_verification_matches_the_existing_checks(
+    log: tuple[LogCheckpoint, _Log], tmp_path: Path
+) -> None:
+    _, current = log
+    for case, (raw, _) in _variants(current).items():
+        result = verify_log(raw, current.snapshot, current.storage.content)
+        if result.corruption:
+            continue
+        events_dir = tmp_path / case.replace(" ", "-")
+        events_dir.mkdir()
+        (events_dir / "events.jsonl").write_bytes(raw)
+        store = FileEventStore(events_dir)
+        assert store.verify_chain() == (result.chain_valid, result.chain_message), case
+        assert verify(store.read_all(), current.snapshot, current.storage.content) == list(
+            result.replay_diffs
+        ), case
+
+
+def test_a_changed_snapshot_is_reported_the_same_way(log: tuple[LogCheckpoint, _Log]) -> None:
+    checkpoint, current = log
+    snapshot = copy.deepcopy(current.snapshot)
+    snapshot.nodes["d"].state = NodeState.COMPLETED
+    del snapshot.contracts[("b", "d")]
+
+    full = verify_log(current.raw, snapshot, current.storage.content)
+    incremental = verify_appended(checkpoint, current.raw, snapshot, current.storage.content)
+
+    assert not full.valid and full.replay_diffs and not full.contracts_match
+    assert incremental.conclusion() == full.conclusion()
+    assert incremental.incremental
+
+
+class _Rewritten:
+    """A content store whose blobs were edited after the checkpoint."""
+
+    def __init__(self, inner: ContentStore) -> None:
+        self._inner = inner
+
+    def put(self, content: str) -> str:
+        return self._inner.put(content)
+
+    def get(self, ref: str) -> str | None:
+        text = self._inner.get(ref)
+        return None if text is None else text + " (edited)"
+
+    def exists(self, ref: str) -> bool:
+        return self._inner.exists(ref)
+
+
+def test_changed_artifact_text_forces_a_full_check(log: tuple[LogCheckpoint, _Log]) -> None:
+    checkpoint, current = log
+    content = _Rewritten(current.storage.content)
+
+    full = verify_log(current.raw, current.snapshot, content)
+    incremental = verify_appended(checkpoint, current.raw, current.snapshot, content)
+
+    assert incremental.conclusion() == full.conclusion()
+    assert incremental.prefix_preserved and not incremental.incremental
+
+
+def test_checkpoints_survive_serialization_and_chain(
+    log: tuple[LogCheckpoint, _Log], tmp_path: Path
+) -> None:
+    checkpoint, current = log
+    restored = LogCheckpoint.from_dict(json.loads(json.dumps(checkpoint.to_dict())))
+    content = current.storage.content
+
+    first = verify_appended(restored, current.raw, current.snapshot, content)
+    assert first.valid and first.incremental
+    assert first.conclusion() == verify_log(current.raw, current.snapshot, content).conclusion()
+    assert first.checkpoint is not None
+
+    client = CascadeClient(current.storage)
+    assert client.add("e").success
+    later = _Log(current.storage, first.checkpoint.events)
+    second = verify_appended(first.checkpoint, later.raw, later.snapshot, content)
+    assert second.valid and second.incremental and second.events == first.events + 1
+    assert second.conclusion() == verify_log(later.raw, later.snapshot, content).conclusion()
+
+
+def test_unsupported_checkpoint_versions_are_refused(log: tuple[LogCheckpoint, _Log]) -> None:
+    checkpoint, _ = log
+    data = checkpoint.to_dict()
+    data["version"] = 99
+    with pytest.raises(ValueError, match="version"):
+        LogCheckpoint.from_dict(data)
+
+
+def test_a_consumed_checkpoint_cannot_be_reused(log: tuple[LogCheckpoint, _Log]) -> None:
+    checkpoint, current = log
+    content = current.storage.content
+    copied = verify_appended(checkpoint, current.raw, current.snapshot, content)
+    taken = verify_appended(checkpoint, current.raw, current.snapshot, content, consume=True)
+
+    assert taken.conclusion() == copied.conclusion() and taken.incremental
+    assert checkpoint.consumed
+    with pytest.raises(ValueError, match="consumed"):
+        verify_appended(checkpoint, current.raw, current.snapshot, content)
+    with pytest.raises(ValueError, match="consumed"):
+        checkpoint.to_dict()
