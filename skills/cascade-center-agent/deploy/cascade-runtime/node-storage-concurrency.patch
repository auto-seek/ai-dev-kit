+    client = CascadeClient(owner)
+    tokens = {task: client.claim(f"agent-{task}", task, timeout=60).data["token"] for task in "ab"}
+    before = {task: remote_refs(remote)[_heartbeat_ref(task)] for task in "ab"}
+
+    with owner.renewal_view():
+        current = owner.heartbeats.current()
+        beats = [dataclasses.replace(current[task], renewed_at=time.time()) for task in ("a", "b")]
+        owner.heartbeats.renew(beats)
+    moved = {task: remote_refs(remote)[_heartbeat_ref(task)] for task in "ab"}
+    assert all(moved[task] != before[task] for task in "ab")
+
+    other = CascadeClient(_storage(remote, tmp_path / "other"))
+    assert other.renew("b", agent_id="agent-b", token=tokens["b"]).success
+    after_other = remote_refs(remote)
+    with pytest.raises(StateConflictError):
+        with owner.renewal_view(fresh=False):
+            current = owner.heartbeats.current()
+            owner.heartbeats.renew(
+                [dataclasses.replace(current[task], renewed_at=time.time()) for task in "ab"]
+            )
+    assert remote_refs(remote) == after_other
+
