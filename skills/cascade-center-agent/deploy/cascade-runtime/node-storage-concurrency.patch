+def test_heartbeats_of_different_tasks_never_conflict(remote: Path, tmp_path: Path) -> None:
+    publisher = _client(remote, tmp_path / "publisher")
+    for index in range(20):
+        assert publisher.add(f"task-{index:02d}").success
+    start = tmp_path / "start"
+    agents = [
+        start_agent(
+            SRC,
+            _spec(
+                remote,
+                tmp_path / f"agent-{index}",
+                [
+                    {
+                        "op": "claim",
+                        "agent": f"agent-{index}",
+                        "task_id": f"task-{index:02d}",
+                        "timeout": 60,
+                    },
+                    {"op": "wait_for", "marker": str(start)},
+                    {"op": "renew", "agent": f"agent-{index}", "times": 5, "interval": 0.05},
+                ],
+            ),
+        )
+        for index in range(20)
+    ]
+    deadline = time.monotonic() + 120
+    while sum(node["state"] == "ACTIVE" for node in _states(publisher).values()) < 20:
+        assert time.monotonic() < deadline, "agents never claimed their tasks"
+        time.sleep(0.2)
+    state = remote_refs(remote)[STATE_REF]
+    start.touch()
+    results = [finish_agent(agent) for agent in agents]
+
+    renewals = [item for result in results for item in result["results"] if item["op"] == "renew"]
+    assert len(renewals) == 100
+    failed = [item["message"] for item in renewals if not item["success"]]
+    assert failed == [], "\n".join(failed)
+    assert remote_refs(remote)[STATE_REF] == state
+    for index in range(20):
+        assert commit_count(remote, _heartbeat_ref(f"task-{index:02d}")) == 6
