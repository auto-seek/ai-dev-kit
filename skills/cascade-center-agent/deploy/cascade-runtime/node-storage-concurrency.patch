+def test_a_reclaim_that_loses_to_a_renewal_is_redone_and_keeps_the_claim(
+    remote: Path, tmp_path: Path, monkeypatch: pytest.MonkeyPatch
+) -> None:
+    assert _client(remote, tmp_path / "publisher").add("task").success
+    worker = _client(remote, tmp_path / "worker")
+    token = worker.claim("agent-a", "task", timeout=5).data["token"]
+    # The reaper's clock runs 6 s ahead, so to it the claim has expired, while
+    # the owner, on the right clock, can still renew.
+    skewed = type("SkewedTime", (), {"time": staticmethod(lambda: time.time() + 6)})
+    monkeypatch.setattr("cascade.client.query.time", skewed)
+    reaper_storage = _storage(remote, tmp_path / "reaper")
+    reaper = CascadeClient(reaper_storage)
+    real_commit = reaper_storage._commit_state
+    attempts: list[int] = []
+
+    def renew_first() -> str | None:
+        attempts.append(1)
+        if len(attempts) == 1:
+            assert worker.renew("task", agent_id="agent-a", token=token, timeout=60).success
+        return real_commit()
+
+    monkeypatch.setattr(reaper_storage, "_commit_state", renew_first)
+
+    result = reaper.check_timeouts()
+
+    assert result.success, result.message
+    assert result.data["count"] == 0
+    assert len(attempts) == 2
+    node = _states(_client(remote, tmp_path / "observer"))["task"]
+    assert (node["state"], node["agent_id"]) == ("ACTIVE", "agent-a")
+    assert worker.complete("task", agent_id="agent-a", token=token).success
+
