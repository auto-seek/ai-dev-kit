+def test_contested_claims_have_one_winner_and_the_rest_move_on(
+    remote: Path, tmp_path: Path
+) -> None:
+    publisher = _client(remote, tmp_path / "publisher")
+    for index in range(10):
+        assert publisher.add(f"job-{index}").success
+
+    contenders = [
+        start_agent(
+            SRC,
+            _spec(
+                remote,
+                tmp_path / f"hot-{index}",
+                [{"op": "claim", "agent": f"hot-{index}", "task_id": "job-0", "timeout": 60}],
+            ),
+        )
+        for index in range(6)
+    ]
+    hot = [finish_agent(agent)["results"][0] for agent in contenders]
+    assert sum(item["success"] for item in hot) == 1
