+def test_historical_renewal_events_still_replay(remote: Path, tmp_path: Path) -> None:
+    storage = _storage(remote, tmp_path / "writer")
+    client = CascadeClient(storage)
+    assert client.add("task").success
+    token = client.claim("agent-a", "task", timeout=30).data["token"]
+    renewed_at = time.time() + 5
+    # Write the event an older runtime appended for every renewal.
+    with storage.lock():
+        graph = storage.load()
+        assert graph is not None
+        graph.nodes["task"].claimed_at = renewed_at
+        storage.events.emit(
+            EventType.TASK_RENEWED,
+            logical_ts=storage.next_lamport(),
+            node_id="task",
+            agent_id="agent-a",
+            renewed_at=renewed_at,
+            timeout=30.0,
+            epoch=graph.epoch,
+        )
+        storage.save(graph)
+
+    observer = _storage(remote, tmp_path / "observer")
+    with observer.read_snapshot():
+        events = observer.events.read_all()
+        snapshot = observer.load()
+        assert snapshot is not None
+        assert verify(events, snapshot, observer.content) == []
+        assert replay(events, observer.content).nodes["task"].claimed_at == renewed_at
+    assert _states(CascadeClient(observer))["task"]["lease_expires_at"] == renewed_at + 30
+    assert client.complete("task", agent_id="agent-a", token=token).success
+
