+@pytest.mark.parametrize("applied", [True, False])
+def test_unknown_publish_outcome_counts_only_the_observed_target(
+    remote: Path,
+    seeded: CascadeClient,
+    tmp_path: Path,
+    monkeypatch: pytest.MonkeyPatch,
+    applied: bool,
+) -> None:
+    storage = _storage(remote, tmp_path / "writer")
+    base = remote_refs(remote)[STATE_REF]
+    real_run = storage._run
+
+    def lose_the_reply(*args: str, **kwargs: Any) -> subprocess.CompletedProcess[str]:
+        if "--atomic" in args and any(arg.endswith(f":{STATE_REF}") for arg in args):
+            if applied:
+                real_run(*args, **kwargs)
+            raise LockError("Git storage command timed out: push")
+        return real_run(*args, **kwargs)
+
+    monkeypatch.setattr(storage, "_run", lose_the_reply)
+
+    def transaction() -> None:
+        with storage.lock():
+            _changed(storage, "mine")
+
+    if applied:
+        transaction()
+        assert remote_refs(remote)[STATE_REF] == storage.state_oid != base
+    else:
+        with pytest.raises(LockError, match="compare-and-swap command failed"):
+            transaction()
+        assert remote_refs(remote)[STATE_REF] == base
+    monkeypatch.undo()
+    assert ("mine" in _ids(_client(remote, tmp_path / "observer"))) is applied
+
+
+def test_lost_cas_redoes_the_write_on_the_latest_state(
+    remote: Path, seeded: CascadeClient, tmp_path: Path, monkeypatch: pytest.MonkeyPatch
+) -> None:
+    storage = _storage(remote, tmp_path / "writer")
+    client = CascadeClient(storage)
+    intruder = _client(remote, tmp_path / "intruder")
+    real_commit = storage._commit_state
+    attempts: list[str | None] = []
+
+    def race_then_commit() -> str | None:
+        attempts.append(storage.state_oid)
+        if len(attempts) == 1:
+            # Another writer publishes after this attempt read the state.
+            assert intruder.add("intruder").success
+        return real_commit()
+
+    monkeypatch.setattr(storage, "_commit_state", race_then_commit)
+
+    assert client.add("mine", op_id="add-mine").success
+    assert len(attempts) == 2 and attempts[0] != attempts[1]
+    assert _ids(_client(remote, tmp_path / "observer")) == ["alpha", "beta", "intruder", "mine"]
+    history = _client(remote, tmp_path / "auditor").history(node_id="mine").data["events"]
+    assert [event["type"] for event in history] == ["node_added"]
+    repeated = client.add("mine", op_id="add-mine")
+    assert repeated.success and len(attempts) == 3
