+@pytest.mark.parametrize("transient", [True, False])
+def test_a_failed_heartbeat_push_is_retried_then_reported(
+    remote: Path, tmp_path: Path, monkeypatch: pytest.MonkeyPatch, transient: bool
+) -> None:
+    assert _client(remote, tmp_path / "publisher").add("task").success
+    storage = _storage(remote, tmp_path / "worker")
+    worker = CascadeClient(storage)
+    token = worker.claim("agent-a", "task", timeout=60).data["token"]
+    real_push = storage._push_refs
+    failures: list[int] = []
+
+    def flaky_push(updates: Any) -> None:
+        if not transient or not failures:
+            failures.append(1)
+            raise LockError("Git heartbeat compare-and-swap command failed: remote: fatal: busy")
+        real_push(updates)
+
+    monkeypatch.setattr(storage, "_push_refs", flaky_push)
+
+    result = worker.renew("task", agent_id="agent-a", token=token)
+
+    if transient:
+        assert result.success and failures == [1]
+    else:
+        assert result.code == ErrorCode.INTERNAL_ERROR
+        assert "command failed" in result.message
+        assert len(failures) == 4  # the cached attempt plus three on fresh data
+
