+"""Remote-call budgets and mixed 0.8.x runtimes on real bare Git remotes.
+
+Perspective: an operator replacing 0.8.2+nodecollab.1 agents and center with
+this runtime.
+Invariant: each read, write and renewal needs fewer remote Git calls than the
+older runtimes; mixed writers never lose or half-publish an update; this
+runtime replays the renewals older ones wrote and can share their cache
+directory. Older runtimes cannot see heartbeats, which is why the switch must
+refuse their writes.
+Goal: prove the SSH-login reduction and the upgrade constraints.
+Migration: older-runtime tests need ``CASCADE_LEGACY_WHEEL`` (nodecollab.1)
+and, for the .2 column, ``CASCADE_NODECOLLAB2_WHEEL``; they skip without them.
+The budget test for this runtime always runs.
+"""
+
+from __future__ import annotations
+
+import json
+import os
+import time
+import zipfile
+from collections import Counter
+from pathlib import Path
+from typing import Any
+
+import pytest
+from git_remote_kit import (
+    SRC,
+    commit_count,
+    finish_agent,
+    install_git_counter,
+    make_remote,
+    remote_calls,
+    remote_refs,
+    run_agent,
+    start_agent,
+)
+
+import cascade
+from cascade.client import CascadeClient
+from cascade.replay import verify
+from cascade.storage.git_storage import GitStorage
+from cascade.types import heartbeat_key
+
+LEGACY_VERSION = "0.8.2+nodecollab.1"
+NAMESPACE = "compat"
+STATE_REF = f"refs/heads/cascade-state/{NAMESPACE}"
+LOCK_REF = f"refs/heads/cascade-lock/{NAMESPACE}"
+# Remote calls per operation for this runtime with a warm local cache: every
+# sync is one fetch (it transfers nothing when no ref moved), every write one
+# atomic push, and a renewal is one heartbeat push.
+BUDGET = {
+    "read": {"fetch": 1},
+    "read_after_foreign_write": {"fetch": 1},
+    "write": {"fetch": 1, "push": 1},
+    "write_after_foreign_write": {"fetch": 1, "push": 1},
+    "renew": {"push": 1},
+    "renew_in_new_process": {"push": 1},
+    "write_while_another_process_holds_a_transaction_3s": {"fetch": 1, "push": 1},
+}
+
+
+def _extract(wheel: str, version: str, target: Path) -> Path:
+    with zipfile.ZipFile(wheel) as archive:
+        archive.extractall(target)
+    metadata = next(target.glob("cascade_auto-*.dist-info/METADATA")).read_text(encoding="utf-8")
+    assert f"\nVersion: {version}\n" in metadata, f"{wheel} is not {version}"
+    return target
+
+
+@pytest.fixture(scope="module")
+def legacy_runtime(tmp_path_factory: pytest.TempPathFactory) -> Path:
+    wheel = os.environ.get("CASCADE_LEGACY_WHEEL")
+    if not wheel:
+        pytest.skip(f"set CASCADE_LEGACY_WHEEL to the unchanged {LEGACY_VERSION} wheel")
+    return _extract(wheel, LEGACY_VERSION, tmp_path_factory.mktemp("nodecollab-1"))
+
+
+@pytest.fixture(scope="module")
+def nodecollab2_runtime(tmp_path_factory: pytest.TempPathFactory) -> Path:
+    wheel = os.environ.get("CASCADE_NODECOLLAB2_WHEEL")
+    if not wheel:
+        pytest.skip("set CASCADE_NODECOLLAB2_WHEEL to the 0.8.2+nodecollab.2 wheel")
+    return _extract(wheel, "0.8.2+nodecollab.2", tmp_path_factory.mktemp("nodecollab-2"))
+
+
+def _spec(remote: Path, cache: Path, ops: list[dict[str, Any]]) -> dict[str, Any]:
+    return {"remote": str(remote), "namespace": NAMESPACE, "cache": str(cache), "ops": ops}
+
+
+def _seed(remote: Path, cache: Path) -> None:
+    client = CascadeClient(GitStorage(str(remote), namespace=NAMESPACE, cache_dir=cache))
+    for node_id in ("alpha", "beta", "gamma"):
+        assert client.add(node_id).success
+
+
+def _audit(remote: Path, cache: Path) -> set[str]:
+    """Verify chain and replay from this runtime; return the committed node IDs."""
+    storage = GitStorage(str(remote), namespace=NAMESPACE, cache_dir=cache)
+    with storage.read_snapshot():
+        graph = storage.load()
+        assert graph is not None
+        assert storage.events.verify_chain() == (True, "")
+        assert verify(storage.events.read_all(), graph, storage.content) == []
+    return set(graph.nodes)
+
+
+def _measure(runtime: Path, remote: Path, root: Path, bin_dir: Path, scenario: str) -> Counter[str]:
+    """Count remote calls of one operation in a process whose cache is warm."""
+    log = root / f"{scenario}.log"
+    ops: list[dict[str, Any]] = []
+    if scenario.endswith("_after_foreign_write"):
+        ops.append({"op": "foreign_add", "cache": str(root / "foreign"), "id": f"{scenario}-f"})
+    if scenario == "renew":
+        ops.append({"op": "claim", "agent": "agent-a", "task_id": "alpha", "timeout": 60})
+        ops.append({"op": "renew", "agent": "agent-a", "log": str(log)})
+    elif scenario == "renew_in_new_process":
+        claim = run_agent(
+            runtime,
+            _spec(
+                remote,
+                root / "cache",
+                [{"op": "claim", "agent": "agent-a", "task_id": "alpha", "timeout": 60}],
+            ),
+        )["results"][0]
+        ops.append(
+            {
+                "op": "renew",
+                "agent": "agent-a",
+                "task_id": "alpha",
+                "token": claim["token"],
+                "log": str(log),
+            }
+        )
+    else:
+        kind = "nodes" if scenario.startswith("read") else "add"
+        ops.append({"op": kind, "id": f"{scenario}-node", "log": str(log)})
+    result = run_agent(runtime, _spec(remote, root / "cache", ops), path_prefix=bin_dir)
+    assert all(item["success"] for item in result["results"]), result
+    return remote_calls(log)
+
+
+def _measure_beside_open_transaction(
+    runtime: Path, remote: Path, root: Path, bin_dir: Path
+) -> Counter[str]:
+    """Count a write's remote calls while another process sits in a transaction ~3 s."""
+    marker = root / "held"
+    log = root / "contended.log"
+    holder = start_agent(
+        runtime,
+        _spec(remote, root / "holder", [{"op": "hold", "marker": str(marker), "seconds": 3}]),
+    )
+    try:
+        waiter = run_agent(
+            runtime,
+            _spec(
+                remote,
+                root / "waiter",
+                [
+                    {"op": "wait_for", "marker": str(marker)},
+                    {"op": "add", "id": "contended", "log": str(log)},
+                ],
+            ),
+            path_prefix=bin_dir,
+        )
+    finally:
+        finish_agent(holder)
+    assert waiter["results"][-1]["success"], waiter
+    return remote_calls(log)
+
+
+def _measure_all(runtime: Path, root: Path, bin_dir: Path) -> dict[str, Counter[str]]:
+    counts: dict[str, Counter[str]] = {}
+    for scenario in BUDGET:
+        remote = make_remote(root / scenario / "remote.git")
+        _seed(remote, root / scenario / "seed")
+        if scenario == "write_while_another_process_holds_a_transaction_3s":
+            counts[scenario] = _measure_beside_open_transaction(
+                runtime, remote, root / scenario, bin_dir
+            )
+        else:
+            counts[scenario] = _measure(runtime, remote, root / scenario, bin_dir, scenario)
+    return counts
+
+
+def test_remote_call_budget_per_operation(tmp_path: Path) -> None:
+    counts = _measure_all(SRC, tmp_path, install_git_counter(tmp_path / "bin"))
+
+    for scenario, expected in BUDGET.items():
+        assert counts[scenario] == expected, scenario
+
+
+def test_remote_calls_drop_against_older_runtimes(
+    legacy_runtime: Path,
+    nodecollab2_runtime: Path,
+    tmp_path: Path,
+    capsys: pytest.CaptureFixture[str],
+) -> None:
+    bin_dir = install_git_counter(tmp_path / "bin")
+    columns = {
+        "nodecollab.1": _measure_all(legacy_runtime, tmp_path / "nc1", bin_dir),
+        "nodecollab.2": _measure_all(nodecollab2_runtime, tmp_path / "nc2", bin_dir),
+        "nodecollab.3": _measure_all(SRC, tmp_path / "nc3", bin_dir),
+    }
+    table = {
+        scenario: {
+            label: {"calls": dict(counts[scenario]), "total": counts[scenario].total()}
+            for label, counts in columns.items()
+        }
+        for scenario in BUDGET
+    }
+    report = os.environ.get("CASCADE_CALL_REPORT")
+    if report:
+        Path(report).write_text(json.dumps(table, indent=2, sort_keys=True), encoding="utf-8")
+    with capsys.disabled():
+        print("\nremote git calls per operation (nodecollab.1 / .2 / .3):")
+        for scenario, row in table.items():
+            totals = " / ".join(str(row[label]["total"]) for label in columns)
+            print(f"  {scenario}: {totals}")
+    for scenario, row in table.items():
+        assert row["nodecollab.3"]["total"] < row["nodecollab.1"]["total"], scenario
+        assert row["nodecollab.3"]["total"] <= row["nodecollab.2"]["total"], scenario
+
+
+def test_legacy_agent_runs_the_unchanged_runtime(legacy_runtime: Path, tmp_path: Path) -> None:
+    remote = make_remote(tmp_path / "remote.git")
+    result = run_agent(legacy_runtime, _spec(remote, tmp_path / "cache", [{"op": "nodes"}]))
+    assert result["version"] == LEGACY_VERSION
+    assert Path(result["file"]).resolve().is_relative_to(legacy_runtime.resolve())
+
+
+def test_mixed_runtime_writers_never_lose_or_half_publish(
+    legacy_runtime: Path, tmp_path: Path
+) -> None:
+    remote = make_remote(tmp_path / "remote.git")
+    _seed(remote, tmp_path / "seed")
+    commits_before = commit_count(remote, STATE_REF)
+    agents = []
+    for index in range(6):
+        runtime = legacy_runtime if index % 2 else SRC
+        ids = [f"{'old' if index % 2 else 'new'}{index}-{step}" for step in range(4)]
+        agents.append(
+            start_agent(
+                runtime,
+                _spec(remote, tmp_path / f"agent-{index}", [{"op": "add", "id": i} for i in ids]),
+            )
+        )
+    results = [finish_agent(agent) for agent in agents]
+
+    items = [(r["version"], item) for r in results for item in r["results"]]
+    assert {version for version, _ in items} == {LEGACY_VERSION, cascade.__version__}
+    # This runtime redoes a lost compare-and-swap; the old one reports it.
+    assert [i for v, i in items if v == cascade.__version__ and not i["success"]] == []
+    legacy_failures = [i for v, i in items if v == LEGACY_VERSION and not i["success"]]
+    assert all("compare-and-swap" in item["message"] for item in legacy_failures)
+    published = {item["id"] for _, item in items if item["success"]}
+    assert _audit(remote, tmp_path / "auditor") == published | {"alpha", "beta", "gamma"}
+    assert commit_count(remote, STATE_REF) == commits_before + len(published)
+    assert LOCK_REF not in remote_refs(remote)
+
+
+def test_legacy_runtime_reads_current_state_but_ignores_heartbeats(
+    legacy_runtime: Path, tmp_path: Path
+) -> None:
+    remote = make_remote(tmp_path / "remote.git")
+    _seed(remote, tmp_path / "seed")
+    worker = CascadeClient(GitStorage(str(remote), namespace=NAMESPACE, cache_dir=tmp_path / "w"))
+    token = worker.claim("agent-a", "alpha", timeout=4).data["token"]
+    time.sleep(2.5)
+    assert worker.renew("alpha", agent_id="agent-a", token=token).success
+    time.sleep(2.0)
+
+    legacy = run_agent(
+        legacy_runtime,
+        _spec(remote, tmp_path / "old", [{"op": "nodes"}, {"op": "check_timeouts"}]),
+    )
+
+    # The renewal keeps the claim alive, but the old runtime only sees
+    # claimed_at and reclaims it: the reason the switch must refuse old writers.
+    assert legacy["results"][0]["ids"] == ["alpha", "beta", "gamma"]
+    assert legacy["results"][1]["released"] == ["alpha"]
+    heartbeat = f"refs/heads/cascade-heartbeat/{NAMESPACE}/{heartbeat_key('alpha')}"
+    assert heartbeat in remote_refs(remote)
+    # The next write of this runtime removes the orphaned heartbeat.
+    assert worker.add("delta").success
+    assert heartbeat not in remote_refs(remote)
+
+
+def test_current_runtime_replays_legacy_renewals_and_finishes_their_claims(
+    legacy_runtime: Path, tmp_path: Path
+) -> None:
+    remote = make_remote(tmp_path / "remote.git")
+    _seed(remote, tmp_path / "seed")
+    legacy = run_agent(
+        legacy_runtime,
+        _spec(
+            remote,
+            tmp_path / "old",
+            [
+                {"op": "claim", "agent": "agent-a", "task_id": "alpha", "timeout": 60},
+                {"op": "renew", "agent": "agent-a", "times": 2, "interval": 0.1},
+            ],
+        ),
+    )
+    assert all(item["success"] for item in legacy["results"]), legacy
+    token = legacy["results"][0]["token"]
+
+    current = CascadeClient(
+        GitStorage(str(remote), namespace=NAMESPACE, cache_dir=tmp_path / "new")
+    )
+    renewals = [e for e in current.history().data["events"] if e["type"] == "task_renewed"]
+    assert len(renewals) == 2
+    node = {item["id"]: item for item in current.nodes().data["nodes"]}["alpha"]
+    assert node["renewed_at"] == renewals[-1]["data"]["renewed_at"]
+    assert current.complete("alpha", agent_id="agent-a", token=token).success
+    assert _audit(remote, tmp_path / "auditor") == {"alpha", "beta", "gamma"}
+
+
+def test_legacy_and_current_processes_can_share_one_cache_directory(
+    legacy_runtime: Path, tmp_path: Path
+) -> None:
+    remote = make_remote(tmp_path / "remote.git")
+    _seed(remote, tmp_path / "seed")
+    shared = tmp_path / "shared-cache"
+    for runtime, node_id in ((legacy_runtime, "old-a"), (SRC, "new-a"), (legacy_runtime, "old-b")):
+        result = run_agent(runtime, _spec(remote, shared, [{"op": "add", "id": node_id}]))
+        assert result["results"][0]["success"], result
+
+    agents = [
+        start_agent(
+            legacy_runtime if index % 2 else SRC,
+            _spec(
+                remote, shared, [{"op": "add", "id": f"shared{index}-{step}"} for step in range(3)]
+            ),
+        )
+        for index in range(4)
+    ]
+    results = [finish_agent(agent) for agent in agents]
+
+    assert [item for r in results for item in r["results"] if not item["success"]] == []
+    expected = {"alpha", "beta", "gamma", "old-a", "new-a", "old-b"}
+    expected |= {f"shared{index}-{step}" for index in range(4) for step in range(3)}
+    current_view = run_agent(SRC, _spec(remote, shared, [{"op": "nodes"}]))
+    legacy_view = run_agent(legacy_runtime, _spec(remote, shared, [{"op": "nodes"}]))
+    assert set(current_view["results"][0]["ids"]) == expected
+    assert set(legacy_view["results"][0]["ids"]) == expected
+    assert _audit(remote, tmp_path / "auditor") == expected
