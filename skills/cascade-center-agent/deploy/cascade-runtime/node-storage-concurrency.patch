+def test_lost_state_cas_raises_conflict_and_publishes_nothing(
+    remote: Path, seeded: CascadeClient, tmp_path: Path
+) -> None:
+    storage = _storage(remote, tmp_path / "writer")
+    base = remote_refs(remote)[STATE_REF]
+
+    with pytest.raises(StateConflictError, match="nothing was published"):
+        with storage.lock():
+            _changed(storage, "mine")
+            rogue = _rogue_commit(remote, base, "a writer that published first")
+            _set_ref(remote, STATE_REF, rogue)
+
+    refs = remote_refs(remote)
+    assert refs[STATE_REF] == rogue
+    assert LOCK_REF not in refs
+    assert "mine" not in _ids(_client(remote, tmp_path / "observer"))
+
+
+def test_policy_rejection_keeps_old_state_and_is_not_a_conflict(
+    remote: Path, seeded: CascadeClient, tmp_path: Path
+) -> None:
+    storage = _storage(remote, tmp_path / "writer")
+    before = remote_refs(remote)
+    _install_hook(
+        remote,
+        "pre-receive",
+        f'while read old new ref; do [ "$ref" = "{STATE_REF}" ] && exit 1; done\nexit 0\n',
+    )
+
+    with pytest.raises(LockError, match="compare-and-swap command failed") as caught:
+        with storage.lock():
+            _changed(storage, "mine")
+
+    assert not isinstance(caught.value, StateConflictError)
+    assert remote_refs(remote) == before
+
