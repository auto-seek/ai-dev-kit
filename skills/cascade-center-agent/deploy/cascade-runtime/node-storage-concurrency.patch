+# ---------------------------------------------------------------------------
+# Heartbeat — lease renewal kept outside the event log.
+# ---------------------------------------------------------------------------
+HEARTBEAT_FIELDS = frozenset(
+    {"namespace", "task_id", "agent_id", "claim_token", "renewed_at", "timeout", "runtime"}
+)
+HEARTBEAT_MAX_BYTES = 4096
+
+
+def heartbeat_key(task_id: str) -> str:
+    """Ref-safe key for a task's heartbeat: lowercase hex SHA-256 of the task ID.
+
+    Task IDs may contain ``..`` or end in ``.lock``, which Git ref components
+    reject, so the ref name never contains the ID itself.
+    """
+    return hashlib.sha256(task_id.encode("utf-8")).hexdigest()
+
+
+@dataclass(frozen=True, slots=True)
+class Heartbeat:
+    """Latest liveness signal of one ACTIVE claim.
+
+    It counts only while ``task_id``, ``agent_id`` and ``claim_token`` equal
+    the node's current claim; the effective renewal time is then
+    ``max(node.claimed_at, renewed_at)`` and ``timeout`` replaces the node's.
+    """
+
+    namespace: str
+    task_id: str
+    agent_id: str
+    claim_token: int
+    renewed_at: float
+    timeout: float | None
+    runtime: str
+
+    def to_payload(self) -> dict[str, Any]:
+        return {
+            "namespace": self.namespace,
+            "task_id": self.task_id,
+            "agent_id": self.agent_id,
+            "claim_token": self.claim_token,
+            "renewed_at": self.renewed_at,
+            "timeout": self.timeout,
+            "runtime": self.runtime,
+        }
+
+    @classmethod
+    def from_payload(cls, data: Any) -> "Heartbeat":
+        """Parse a stored payload; raise ValueError for anything malformed."""
+        if not isinstance(data, dict) or set(data) != HEARTBEAT_FIELDS:
+            raise ValueError("heartbeat payload has missing or extra fields")
+        for name in ("namespace", "agent_id", "runtime"):
+            value = data[name]
+            if not isinstance(value, str) or not 1 <= len(value) <= 256:
+                raise ValueError(f"heartbeat {name} must be 1-256 characters")
+        validate_node_id(data["task_id"])
+        token = data["claim_token"]
+        if type(token) is not int or token < 1:
+            raise ValueError("heartbeat claim_token must be a positive integer")
+        renewed_at = data["renewed_at"]
+        if type(renewed_at) not in (int, float) or not math.isfinite(renewed_at):
+            raise ValueError("heartbeat renewed_at must be a finite number")
+        timeout = data["timeout"]
+        if timeout is not None and (
+            type(timeout) not in (int, float) or not math.isfinite(timeout) or timeout <= 0
+        ):
+            raise ValueError("heartbeat timeout must be null or a positive finite number")
+        return cls(
+            namespace=data["namespace"],
+            task_id=data["task_id"],
+            agent_id=data["agent_id"],
+            claim_token=token,
+            renewed_at=float(renewed_at),
+            timeout=None if timeout is None else float(timeout),
