+) -> None:
+    holder = GitRefLease(str(remote), "demo", tmp_path / "a.git", holder_id="a")
+    holder.acquire(blocking=False)
+    contender = GitRefLease(str(remote), "demo", tmp_path / "b.git", holder_id="b")
+    fetches: list[tuple[str, ...]] = []
+    real_run = contender._run
+
+    def run(*args: str, **kwargs: Any) -> subprocess.CompletedProcess[str]:
+        if "fetch" in args:
+            fetches.append(args)
+        return real_run(*args, **kwargs)
+
+    monkeypatch.setattr(contender, "_run", run)
+    bounds, sleeps = _record_backoff(monkeypatch)
+    started = time.monotonic()
+
+    with pytest.raises(LockContentionError, match="held by a"):
+        contender.acquire(timeout=4.0, poll_interval=0.01, max_poll_interval=0.08)
+
+    elapsed = time.monotonic() - started
+    ceilings = [high for _, high in bounds]
+    assert ceilings[:5] == pytest.approx([0.01, 0.02, 0.04, 0.08, 0.08])
+    assert all(low == pytest.approx(high / 2) for low, high in bounds)
+    assert max(sleeps) <= 0.08
+    assert 4.0 <= elapsed < 8.0
+    # The holder's lease commit does not change, so its payload is fetched once.
+    assert len(fetches) == 1
+    assert holder.release()
+
