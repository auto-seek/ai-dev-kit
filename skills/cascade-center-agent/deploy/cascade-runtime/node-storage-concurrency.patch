+def test_corrupt_remote_snapshot_fails_without_falling_back(
+    remote: Path, seeded: CascadeClient, tmp_path: Path
+) -> None:
+    storage = _storage(remote, tmp_path / "reader")
+    assert _ids(CascadeClient(storage)) == ["alpha", "beta"]
+    good = remote_refs(remote)[STATE_REF]
+    work = tmp_path / "corruptor"
+    subprocess.run(["git", "clone", "--quiet", str(remote), str(work)], check=True)
+    subprocess.run(["git", "-C", str(work), "checkout", "--quiet", good], check=True)
+    (work / "data" / "graph.json").write_text("{not json", encoding="utf-8")
+    subprocess.run(
+        ["git", "-C", str(work), "-c", "user.name=t", "-c", "user.email=t@t"]
+        + ["commit", "--quiet", "-am", "corrupt"],
+        check=True,
+    )
+    subprocess.run(
+        ["git", "-C", str(work), "push", "--quiet", "origin", f"HEAD:{STATE_REF}"], check=True
+    )
+    corrupt = remote_refs(remote)[STATE_REF]
+
+    with pytest.raises(StorageCorruptionError, match="malformed JSON"):
+        with storage.read_snapshot():
+            storage.load()
+    assert storage.state_oid == corrupt
