+def test_a_client_killed_inside_its_transaction_blocks_nobody(remote: Path, tmp_path: Path) -> None:
+    assert _client(remote, tmp_path / "publisher").add("task").success
+    marker = tmp_path / "inside"
+    victim = start_agent(
+        SRC,
+        _spec(remote, tmp_path / "victim", [{"op": "stall_in_transaction", "marker": str(marker)}]),
+    )
+    deadline = time.monotonic() + 30
+    while not marker.exists():
+        assert time.monotonic() < deadline
+        time.sleep(0.02)
+    os.kill(victim.pid, signal.SIGKILL)
+    victim.wait(timeout=5)
+
+    started = time.monotonic()
+    claimed = _client(remote, tmp_path / "survivor").claim("agent-b", "task", timeout=60)
+
+    assert claimed.success
+    assert time.monotonic() - started < 30
