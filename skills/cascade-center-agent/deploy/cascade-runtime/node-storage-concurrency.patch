+def test_twenty_writers_lose_no_update_and_keep_a_valid_chain(
+    remote: Path, tmp_path: Path, capsys: pytest.CaptureFixture[str]
+) -> None:
+    publisher = _client(remote, tmp_path / "publisher")
+    assert publisher.add("seed").success
+    commits = commit_count(remote, STATE_REF)
+    agents = [
+        start_agent(
+            SRC,
+            _spec(
+                remote,
+                tmp_path / f"w-{index}",
+                [{"op": "add", "id": f"w{index:02d}-{step}"} for step in range(3)],
+            ),
+        )
+        for index in range(20)
+    ]
+    results = [finish_agent(agent) for agent in agents]
+
+    items = [item for r in results for item in r["results"]]
+    failed = [item for item in items if not item["success"]]
+    # A write that runs out of redo time fails explicitly and publishes nothing.
+    assert {item["code"] for item in failed} <= {ErrorCode.STATE_CONFLICT}, failed
+    published = {item["id"] for item in items if item["success"]}
+    storage = _storage(remote, tmp_path / "auditor")
+    with storage.read_snapshot():
+        graph = storage.load()
+        assert graph is not None
+        events = storage.events.read_all()
+        assert storage.events.verify_chain() == (True, "")
+        assert verify(events, graph, storage.content) == []
+    assert set(graph.nodes) == published | {"seed"}
+    assert len(events) == 1 + len(published)
+    assert commit_count(remote, STATE_REF) == commits + len(published)
+    with capsys.disabled():
+        print(f"\n20-writer burst: {len(failed)} of 60 writes ran out of redo time")
