+def test_heartbeat_payload_rejects_malformed_fields() -> None:
+    good = {
+        "namespace": "ns",
+        "task_id": "task",
+        "agent_id": "agent",
+        "claim_token": 3,
+        "renewed_at": 1.5,
+        "timeout": None,
+        "runtime": "0.8.2+nodecollab.3",
+    }
+    assert Heartbeat.from_payload(good).timeout is None
+    for change in (
+        {"claim_token": True},
+        {"claim_token": 0},
+        {"renewed_at": float("nan")},
+        {"timeout": -1},
+        {"task_id": "../x"},
+        {"agent_id": ""},
+        {"extra": 1},
+    ):
+        with pytest.raises(ValueError):
+            Heartbeat.from_payload({**good, **change})
