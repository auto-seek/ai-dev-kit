+    assert done.success is renew, done.message
+    assert _states(observer)["task"]["state"] == ("COMPLETED" if renew else "READY")
+    assert _heartbeat_ref("task") not in remote_refs(remote)
+    with observer.storage.read_snapshot():
+        graph = observer.storage.load()
+        assert graph is not None
+        assert verify(observer.storage.events.read_all(), graph, observer.storage.content) == []
