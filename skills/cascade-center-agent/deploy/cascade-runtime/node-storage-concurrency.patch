+def test_a_client_killed_during_its_push_blocks_nobody(remote: Path, tmp_path: Path) -> None:
+    assert _client(remote, tmp_path / "publisher").add("task").success
+    trap = tmp_path / "trap"
+    reached = tmp_path / "reached"
+    trap.touch()
+    # The first state push stalls in the receive hook; later pushes pass.
+    hook = remote / "hooks" / "pre-receive"
+    hook.write_text(
+        f'#!/bin/sh\nif rm "{trap}" 2>/dev/null; then touch "{reached}"; sleep 30; fi\nexit 0\n',
+        encoding="utf-8",
+    )
+    hook.chmod(0o755)
+    victim = start_agent(
+        SRC,
+        _spec(remote, tmp_path / "victim", [{"op": "claim", "agent": "agent-a", "timeout": 60}]),
+    )
+    deadline = time.monotonic() + 30
+    while not reached.exists():
+        assert time.monotonic() < deadline, "victim never reached the receive hook"
+        time.sleep(0.02)
+    os.kill(victim.pid, signal.SIGKILL)
+    victim.wait(timeout=5)
+
+    started = time.monotonic()
+    claimed = _client(remote, tmp_path / "survivor").claim("agent-b", "task", timeout=60)
+
+    assert claimed.success, claimed.message
+    # Far below the 120 s lease plus skew an older runtime would wait out.
+    assert time.monotonic() - started < 30
+    assert _payload(remote, "task")["agent_id"] == "agent-b"
